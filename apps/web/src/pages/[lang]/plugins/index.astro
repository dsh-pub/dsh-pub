---
import EcosystemCard from '../../../components/EcosystemCard.astro';
import Icon from '../../../components/Icon.astro';
import PluginRow from '../../../components/PluginRow.astro';
import { communityEntries, marketplaceEntries } from '../../../lib/catalog.js';
import { displayName } from '../../../lib/catalog-types.js';
import { ecosystemCatalog, ecosystemCategories, ecosystemEntries } from '../../../lib/ecosystem.js';
import { typeLabel } from '../../../lib/categories.js';
import { copy, isLocale, locales } from '../../../lib/i18n.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang;
if (!isLocale(locale)) throw new Error(`Unsupported locale: ${locale}`);
const t = copy[locale];
const ecosystemTypes = [...new Set(ecosystemEntries.map((entry) => entry.resourceType))]
  .map((type) => ({
    type,
    count: ecosystemEntries.filter((entry) => entry.resourceType === type).length,
  }))
  .sort((left, right) => right.count - left.count);
const reviewedCount = communityEntries.filter(
  (entry) => entry.provenance?.status === 'community-reviewed',
).length;
const submittedCount = communityEntries.filter(
  (entry) => entry.provenance?.status === 'community-submitted',
).length;
const automatedCount = communityEntries.filter(
  (entry) => entry.provenance?.status === 'community-automated',
).length;
const registryUrl = `https://dsh.pub/${locale}/plugins/`;
const ui =
  locale === 'zh'
    ? {
        coordinate: 'DSH / REGISTRY / ECOSYSTEM',
        lead: `浏览 ${marketplaceEntries.length} 条结构化 Registry 记录与 ${ecosystemCatalog.totals.indexed} 条公开生态索引。先发现，再核对来源、能力和安装边界。`,
        search: '按插件名、作者、能力、Tool 或仓库搜索…',
        registry: 'Registry 记录',
        ecosystem: '生态索引',
        all: '全部',
        shown: '条结果',
        scope: '数据范围',
        allTypes: '全部类型',
        allSignals: '全部来源状态',
        ecosystemIndexed: '生态索引 · 未验证',
        quickUseCases: '按使用场景',
        discoveryNote:
          '生态索引来自 DSH.Tools 的公开目录，源仓库仍是事实来源。Indexed 不代表兼容、可安装、已审核或安全。',
        sortStars: 'Stars',
        sortUpdated: '最近更新',
        registryCount: `${marketplaceEntries.length} 条结构化记录`,
        ecosystemCount: `${ecosystemEntries.length} 条公开候选`,
      }
    : {
        coordinate: 'DSH / REGISTRY / ECOSYSTEM',
        lead: `Browse ${marketplaceEntries.length} structured Registry records and ${ecosystemCatalog.totals.indexed} public ecosystem entries. Discover broadly, then inspect source, capability, and installation boundaries.`,
        search: 'Search by plugin, author, capability, tool, or repository…',
        registry: 'Registry records',
        ecosystem: 'Ecosystem index',
        all: 'All',
        shown: 'results',
        scope: 'Data scope',
        allTypes: 'All types',
        allSignals: 'All source signals',
        ecosystemIndexed: 'Ecosystem indexed · unverified',
        quickUseCases: 'Browse by use case',
        discoveryNote:
          'The ecosystem index is imported from the public DSH.Tools directory. Source repositories remain canonical. Indexed does not mean compatible, installable, reviewed, or safe.',
        sortStars: 'Stars',
        sortUpdated: 'Recently updated',
        registryCount: `${marketplaceEntries.length} structured records`,
        ecosystemCount: `${ecosystemEntries.length} public candidates`,
      };
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: t.registryHeading,
    url: registryUrl,
    description: t.registryPageDescription,
    inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
    isPartOf: { '@type': 'WebSite', name: 'dsh.pub', url: `https://dsh.pub/${locale}/` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: marketplaceEntries.length,
      itemListElement: marketplaceEntries.map((entry, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: displayName(entry),
        url: `https://dsh.pub/${locale}/plugins/${entry.slug}/`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: locale === 'zh' ? '首页' : 'Home',
        item: `https://dsh.pub/${locale}/`,
      },
      { '@type': 'ListItem', position: 2, name: t.registryHeading, item: registryUrl },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  title={t.registryPageTitle}
  description={t.registryPageDescription}
  showHeaderSearch={false}
  structuredData={structuredData}
>
  <section class="catalog-masthead">
    <div class="page-shell">
      <p class="eyebrow">{ui.coordinate}</p>
      <h1>{t.registryHeading}</h1>
      <p class="registry-guide-title">{t.registryGuideTitle}</p>
      <p>{ui.lead}</p>
    </div>
  </section>

  <main
    class="catalog-shell page-shell"
    data-catalog
    data-title-registry={ui.registry}
    data-title-ecosystem={ui.ecosystem}
    data-title-all={ui.all}
  >
    <section class="catalog-controls" aria-label={t.filters}>
      <form class="catalog-search" role="search" data-catalog-search>
        <Icon name="search" size={20} />
        <input
          type="search"
          name="q"
          aria-label={t.search}
          placeholder={ui.search}
          autocomplete="off"
        />
        <kbd>/</kbd>
        <span><strong data-result-count>{marketplaceEntries.length}</strong> {ui.shown}</span>
      </form>

      <div class="control-row">
        <div class="scope-switch" role="group" aria-label={ui.scope}>
          <button type="button" class="active" data-scope="registry">
            <strong>{ui.registry}</strong><small>{ui.registryCount}</small>
          </button>
          <button type="button" data-scope="ecosystem">
            <strong>{ui.ecosystem}</strong><small>{ui.ecosystemCount}</small>
          </button>
          <button type="button" data-scope="all"><strong>{ui.all}</strong></button>
        </div>

        <div class="select-filters">
          <label>
            <span>{t.type}</span>
            <select data-type-filter>
              <option value="">{ui.allTypes}</option>
              {
                (['plugin', 'bundle'] as const).map((type) => (
                  <option value={type}>{typeLabel(type, locale)}</option>
                ))
              }
              {
                ecosystemTypes.map(({ type, count }) => (
                  <option value={type}>
                    {type} · {count}
                  </option>
                ))
              }
            </select>
          </label>
          <label>
            <span>{t.sourceScope}</span>
            <select data-provenance-filter>
              <option value="">{ui.allSignals}</option>
              <option value="built-in">{t.builtInSource}</option>
              <option value="community-reviewed">{t.communityReviewed} · {reviewedCount}</option>
              {
                automatedCount > 0 && (
                  <option value="community-automated">
                    {t.communityAutomated} · {automatedCount}
                  </option>
                )
              }
              {
                submittedCount > 0 && (
                  <option value="community-submitted">
                    {t.communitySubmitted} · {submittedCount}
                  </option>
                )
              }
              <option value="ecosystem-indexed">{ui.ecosystemIndexed}</option>
            </select>
          </label>
        </div>
      </div>
    </section>

    <nav class="use-case-filters" aria-label={ui.quickUseCases}>
      <span>{ui.quickUseCases}</span>
      <button type="button" class="active" data-category-filter="">{ui.all}</button>
      {
        ecosystemCategories.slice(0, 8).map(({ category, count }) => (
          <button type="button" data-category-filter={category}>
            {category}
            <small>{count}</small>
          </button>
        ))
      }
    </nav>

    <div class="results-toolbar">
      <div>
        <strong data-results-title>{ui.registry}</strong>
        <p>{ui.discoveryNote}</p>
      </div>
      <label>
        <span>{t.sort}</span>
        <select data-sort>
          <option value="featured">{t.sortFeatured}</option>
          <option value="name">{t.sortName}</option>
          <option value="stars">{ui.sortStars}</option>
          <option value="updated">{ui.sortUpdated}</option>
          <option value="type">{t.sortType}</option>
        </select>
      </label>
    </div>

    <div class="active-filters" data-active-filters aria-live="polite"></div>
    <section class="catalog-grid" data-results aria-label={t.browse}>
      {marketplaceEntries.map((entry) => <PluginRow entry={entry} locale={locale} />)}
      {ecosystemEntries.map((entry) => <EcosystemCard entry={entry} locale={locale} />)}
    </section>

    <div class="empty-results" data-empty hidden>
      <span aria-hidden="true">0×00</span>
      <h2>{t.noResults}</h2>
      <p>{t.noResultsBody}</p>
      <button type="button" data-clear-filters>{t.clear}</button>
    </div>
  </main>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-catalog]');
  const searchForm = document.querySelector<HTMLFormElement>('[data-catalog-search]');
  const searchInput = searchForm?.querySelector<HTMLInputElement>('input[name="q"]');
  const resultContainer = root?.querySelector<HTMLElement>('[data-results]');
  const count = root?.querySelector<HTMLElement>('[data-result-count]');
  const resultsTitle = root?.querySelector<HTMLElement>('[data-results-title]');
  const empty = root?.querySelector<HTMLElement>('[data-empty]');
  const active = root?.querySelector<HTMLElement>('[data-active-filters]');
  const sort = root?.querySelector<HTMLSelectElement>('[data-sort]');
  const typeFilter = root?.querySelector<HTMLSelectElement>('[data-type-filter]');
  const provenanceFilter = root?.querySelector<HTMLSelectElement>('[data-provenance-filter]');
  const scopeButtons = [...(root?.querySelectorAll<HTMLButtonElement>('[data-scope]') ?? [])];
  const categoryButtons = [
    ...(root?.querySelectorAll<HTMLButtonElement>('[data-category-filter]') ?? []),
  ];
  const items = [...(root?.querySelectorAll<HTMLElement>('[data-catalog-item]') ?? [])];
  const originalOrder = new Map(items.map((item, index) => [item, index]));
  let scope = 'registry';
  let category = '';

  function freshness(value = ''): number {
    if (value === 'today') return 0;
    const days = /^(\d+)d ago$/u.exec(value);
    if (days) return Number(days[1]);
    const months = /^(\d+)mo ago$/u.exec(value);
    if (months) return Number(months[1]) * 31;
    const years = /^(\d+)y ago$/u.exec(value);
    if (years) return Number(years[1]) * 365;
    if (value === 'registry') return 1;
    return 9999;
  }

  function setActiveButtons() {
    for (const button of scopeButtons)
      button.classList.toggle('active', button.dataset.scope === scope);
    for (const button of categoryButtons) {
      button.classList.toggle('active', (button.dataset.categoryFilter ?? '') === category);
    }
  }

  function setFromUrl() {
    const params = new URLSearchParams(location.search);
    if (searchInput) searchInput.value = params.get('q') ?? '';
    scope = params.get('scope') ?? 'registry';
    if (!['registry', 'ecosystem', 'all'].includes(scope)) scope = 'registry';
    category = params.get('category') ?? '';
    if (typeFilter) typeFilter.value = params.get('type') ?? '';
    if (provenanceFilter) provenanceFilter.value = params.get('provenance') ?? '';
    if (sort) sort.value = params.get('sort') ?? 'featured';
    setActiveButtons();
  }

  function render() {
    const query = searchInput?.value.trim().toLocaleLowerCase() ?? '';
    const type = typeFilter?.value ?? '';
    const provenance = provenanceFilter?.value ?? '';
    let visible = 0;

    for (const item of items) {
      const origin = item.dataset.origin ?? 'registry';
      const match =
        (!query || item.dataset.search?.includes(query)) &&
        (scope === 'all' || origin === scope) &&
        (!category || item.dataset.category === category) &&
        (!type || item.dataset.type === type) &&
        (!provenance || item.dataset.provenance === provenance);
      item.hidden = !match;
      if (match) visible += 1;
    }

    const sorted = [...items].sort((left, right) => {
      if (sort?.value === 'name')
        return (left.dataset.name ?? '').localeCompare(right.dataset.name ?? '');
      if (sort?.value === 'type')
        return (left.dataset.type ?? '').localeCompare(right.dataset.type ?? '');
      if (sort?.value === 'stars')
        return Number(right.dataset.stars ?? 0) - Number(left.dataset.stars ?? 0);
      if (sort?.value === 'updated')
        return freshness(left.dataset.updated) - freshness(right.dataset.updated);
      return (originalOrder.get(left) ?? 0) - (originalOrder.get(right) ?? 0);
    });
    for (const item of sorted) resultContainer?.append(item);

    if (count) count.textContent = String(visible);
    if (empty) empty.hidden = visible !== 0;
    if (resultsTitle) {
      resultsTitle.textContent =
        scope === 'registry'
          ? (root?.dataset.titleRegistry ?? '')
          : scope === 'ecosystem'
            ? (root?.dataset.titleEcosystem ?? '')
            : (root?.dataset.titleAll ?? '');
    }

    const params = new URLSearchParams();
    if (query) params.set('q', query);
    if (scope !== 'registry') params.set('scope', scope);
    if (category) params.set('category', category);
    if (type) params.set('type', type);
    if (provenance) params.set('provenance', provenance);
    if (sort?.value && sort.value !== 'featured') params.set('sort', sort.value);
    history.replaceState({}, '', `${location.pathname}?${params}`);

    if (active) {
      active.replaceChildren();
      for (const value of [query, category, type, provenance].filter(Boolean)) {
        const chip = document.createElement('span');
        chip.textContent = value;
        active.append(chip);
      }
    }
    root?.classList.add('ready');
  }

  setFromUrl();
  render();
  searchForm?.addEventListener('submit', (event) => event.preventDefault());
  searchInput?.addEventListener('input', render);
  typeFilter?.addEventListener('change', render);
  provenanceFilter?.addEventListener('change', render);
  sort?.addEventListener('change', render);
  for (const button of scopeButtons) {
    button.addEventListener('click', () => {
      scope = button.dataset.scope ?? 'registry';
      if (scope === 'registry') category = '';
      setActiveButtons();
      render();
    });
  }
  for (const button of categoryButtons) {
    button.addEventListener('click', () => {
      category = button.dataset.categoryFilter ?? '';
      if (category) scope = 'ecosystem';
      setActiveButtons();
      render();
    });
  }
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-clear-filters]')) {
    button.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (typeFilter) typeFilter.value = '';
      if (provenanceFilter) provenanceFilter.value = '';
      if (sort) sort.value = 'featured';
      scope = 'registry';
      category = '';
      setActiveButtons();
      render();
      searchInput?.focus();
    });
  }
  document.addEventListener('keydown', (event) => {
    if (event.key === '/' && document.activeElement !== searchInput) {
      event.preventDefault();
      searchInput?.focus();
    }
  });

  for (const element of document.querySelectorAll<HTMLElement>('[data-install-count]')) {
    const slug = element.dataset.installCount;
    if (!slug) continue;
    fetch(`/api/plugins/${encodeURIComponent(slug)}/stats`)
      .then((response) =>
        response.ok ? response.json() : Promise.reject(new Error('stats unavailable')),
      )
      .then((data: { total?: number }) => {
        element.textContent = new Intl.NumberFormat().format(data.total ?? 0);
      })
      .catch(() => undefined);
  }
</script>

<style>
  .catalog-masthead {
    background: var(--color-navy-900);
    border-top: 1px solid rgb(255 255 255 / 5%);
    color: white;
    padding: 3.5rem 0 5.5rem;
  }

  .catalog-masthead :global(.eyebrow) {
    color: var(--color-blue-300);
    margin: 0 0 0.8rem;
  }

  .catalog-masthead h1 {
    font-size: clamp(2.5rem, 5vw, 4.3rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1;
    margin: 0;
  }

  .catalog-masthead .registry-guide-title {
    color: var(--color-blue-300);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    margin: 1rem 0 0;
    text-transform: uppercase;
  }

  .catalog-masthead p:last-child {
    color: #c4d0de;
    line-height: 1.6;
    margin: 1.1rem 0 0;
    max-width: 780px;
  }

  .catalog-shell {
    margin-top: -2.35rem;
    position: relative;
  }

  .catalog-controls {
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    box-shadow: var(--shadow-menu);
    overflow: hidden;
  }

  .catalog-search {
    align-items: center;
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-text-faint);
    display: grid;
    gap: 0.75rem;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    min-height: 68px;
    padding: 0.7rem 1rem;
  }

  .catalog-search input {
    background: transparent;
    border: 0;
    color: var(--color-text);
    font-size: 1rem;
    min-width: 0;
    outline: 0;
  }

  .catalog-search kbd {
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    color: var(--color-text-faint);
    font-size: 0.68rem;
    padding: 0.1rem 0.36rem;
  }

  .catalog-search > span {
    border-left: 1px solid var(--color-rule);
    color: var(--color-text-faint);
    font-size: 0.74rem;
    padding-left: 1rem;
    white-space: nowrap;
  }

  .catalog-search > span strong {
    color: var(--color-text);
    font-family: var(--font-mono);
  }

  .control-row {
    align-items: stretch;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding: 0.8rem 1rem;
  }

  .scope-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .scope-switch button,
  .use-case-filters button {
    background: transparent;
    border: 1px solid var(--color-rule);
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .scope-switch button {
    align-items: flex-start;
    border-radius: 7px;
    display: flex;
    flex-direction: column;
    min-height: 48px;
    padding: 0.5rem 0.8rem;
  }

  .scope-switch button strong {
    color: inherit;
    font-size: 0.79rem;
    font-weight: 580;
  }

  .scope-switch button small {
    color: var(--color-text-faint);
    font-size: 0.64rem;
    margin-top: 0.12rem;
  }

  .scope-switch button.active,
  .use-case-filters button.active {
    background: var(--color-accent-soft);
    border-color: color-mix(in srgb, var(--color-accent) 42%, var(--color-rule));
    color: var(--color-accent);
  }

  .select-filters {
    display: flex;
    gap: 0.65rem;
  }

  .select-filters label,
  .results-toolbar label {
    display: grid;
    gap: 0.25rem;
  }

  .select-filters label > span,
  .results-toolbar label > span {
    color: var(--color-text-faint);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .select-filters select,
  .results-toolbar select {
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 6px;
    color: var(--color-text);
    min-height: 38px;
    padding: 0 2rem 0 0.7rem;
  }

  .use-case-filters {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 1.2rem 0 0;
  }

  .use-case-filters > span {
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    margin-right: 0.3rem;
    text-transform: uppercase;
  }

  .use-case-filters button {
    border-radius: 999px;
    font-size: 0.74rem;
    min-height: 34px;
    padding: 0 0.75rem;
  }

  .use-case-filters button small {
    color: var(--color-text-faint);
    margin-left: 0.35rem;
  }

  .results-toolbar {
    align-items: end;
    display: flex;
    gap: 2rem;
    justify-content: space-between;
    padding: 2.5rem 0 1.2rem;
  }

  .results-toolbar strong {
    font-size: 1.2rem;
    font-weight: 610;
  }

  .results-toolbar p {
    color: var(--color-text-faint);
    font-size: 0.75rem;
    line-height: 1.5;
    margin: 0.45rem 0 0;
    max-width: 720px;
  }

  .active-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    min-height: 0;
  }

  .active-filters:not(:empty) {
    margin-bottom: 1rem;
  }

  .active-filters span {
    background: var(--color-accent-soft);
    border: 1px solid color-mix(in srgb, var(--color-accent) 28%, var(--color-rule));
    border-radius: 999px;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    padding: 0.25rem 0.55rem;
  }

  .catalog-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .catalog-shell:not(.ready) .catalog-grid :global([data-origin='ecosystem']) {
    display: none;
  }

  .empty-results {
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    margin-top: 1rem;
    padding: 4rem 1.5rem;
    text-align: center;
  }

  .empty-results > span {
    color: var(--color-accent);
    font-family: var(--font-mono);
  }

  .empty-results h2 {
    font-size: 1.4rem;
    margin: 0.8rem 0 0;
  }

  .empty-results p {
    color: var(--color-text-muted);
  }

  .empty-results button {
    background: var(--color-accent);
    border: 0;
    border-radius: 6px;
    color: white;
    cursor: pointer;
    min-height: 42px;
    padding: 0 1rem;
  }

  @media (max-width: 1060px) {
    .catalog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .control-row {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 720px) {
    .catalog-masthead {
      padding: 2.8rem 0 4.8rem;
    }

    .catalog-search {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .catalog-search > span {
      border-left: 0;
      grid-column: 1 / -1;
      padding: 0 0 0.2rem 2rem;
    }

    .scope-switch,
    .select-filters {
      width: 100%;
    }

    .scope-switch button {
      flex: 1 1 130px;
    }

    .select-filters {
      flex-direction: column;
    }

    .select-filters select {
      width: 100%;
    }

    .results-toolbar {
      align-items: stretch;
      flex-direction: column;
      gap: 1rem;
    }

    .results-toolbar select {
      width: 100%;
    }

    .catalog-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 500px) {
    .control-row,
