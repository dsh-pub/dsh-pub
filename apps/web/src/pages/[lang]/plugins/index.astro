---
import Icon from '../../../components/Icon.astro';
import PluginRow from '../../../components/PluginRow.astro';
import { categoryCounts, communityEntries, marketplaceEntries } from '../../../lib/catalog.js';
import { categoryLabel, typeLabel } from '../../../lib/categories.js';
import { copy, isLocale, locales } from '../../../lib/i18n.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang;
if (!isLocale(locale)) throw new Error(`Unsupported locale: ${locale}`);
const t = copy[locale];
const categories = categoryCounts(marketplaceEntries);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: locale === 'zh' ? 'DeepSeek Harness 插件目录' : 'DeepSeek Harness plugin directory',
  url: `https://dsh.pub/${locale}/plugins/`,
  description: t.siteDescription,
  inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
  isPartOf: { '@type': 'WebSite', name: 'dsh.pub', url: `https://dsh.pub/${locale}/` },
};
---

<BaseLayout
  locale={locale}
  title={t.plugins}
  showHeaderSearch={false}
  structuredData={structuredData}
>
  <section class="catalog-search-band">
    <div class="page-shell">
      <p class="eyebrow">DSH / REGISTRY / {t.plugins.toLocaleUpperCase()}</p>
      <form class="catalog-search" role="search" data-catalog-search>
        <Icon name="search" size={21} />
        <input
          type="search"
          name="q"
          aria-label={t.search}
          placeholder={t.search}
          autocomplete="off"
        />
        <kbd>/</kbd>
      </form>
    </div>
  </section>

  <div class="catalog-layout page-shell" data-catalog>
    <aside class="filter-rail" aria-label={t.filters}>
      <div class="filter-heading">
        <span><Icon name="filter" size={16} />{t.filters}</span>
        <button type="button" data-clear-filters>{t.clear}</button>
      </div>

      <fieldset>
        <legend>{t.type}</legend>
        {
          (['plugin', 'bundle'] as const).map((type) => (
            <label>
              <input type="checkbox" name="type" value={type} />
              <span>{typeLabel(type, locale)}</span>
              <small>{marketplaceEntries.filter((entry) => entry.type === type).length}</small>
            </label>
          ))
        }
      </fieldset>

      <fieldset>
        <legend>{t.sourceScope}</legend>
        <label>
          <input type="checkbox" name="provenance" value="built-in" />
          <span>{t.builtInSource}</span>
          <small>{marketplaceEntries.length - communityEntries.length}</small>
        </label>
        <label>
          <input type="checkbox" name="provenance" value="community-reviewed" />
          <span>{t.communityReviewed}</span>
          <small>{communityEntries.length}</small>
        </label>
      </fieldset>

      <fieldset>
        <legend>{t.availability}</legend>
        <label>
          <input type="checkbox" name="availability" value="included" />
          <span>{t.included}</span>
          <small
            >{marketplaceEntries.filter((entry) => !entry.distribution.installable).length}</small
          >
        </label>
        {
          marketplaceEntries.some((entry) => entry.distribution.installable) && (
            <label>
              <input type="checkbox" name="availability" value="installable" />
              <span>{t.installable}</span>
              <small>
                {marketplaceEntries.filter((entry) => entry.distribution.installable).length}
              </small>
            </label>
          )
        }
      </fieldset>

      <fieldset>
        <legend>{t.capability}</legend>
        {
          categories.map(([category, count]) => (
            <label>
              <input type="checkbox" name="category" value={category} />
              <span>{categoryLabel(category, locale)}</span>
              <small>{count}</small>
            </label>
          ))
        }
      </fieldset>
    </aside>

    <section class="catalog-results" aria-labelledby="results-heading">
      <div class="results-toolbar">
        <h1 id="results-heading">
          <span>{t.browse}</span>
          <strong data-result-count>{marketplaceEntries.length}</strong>
          {t.results}
        </h1>
        <label>
          <span>{t.sort}</span>
          <select data-sort>
            <option value="featured">{t.sortFeatured}</option>
            <option value="name">{t.sortName}</option>
            <option value="type">{t.sortType}</option>
          </select>
        </label>
      </div>

      <p class="community-policy">
        <strong>{t.communityReviewed}</strong> — {t.communityReviewNotice}
      </p>

      <div class="active-filters" data-active-filters aria-live="polite"></div>
      <div class="plugin-results" data-results>
        {marketplaceEntries.map((entry) => <PluginRow entry={entry} locale={locale} />)}
      </div>
      <div class="empty-results" data-empty hidden>
        <span aria-hidden="true">0×00</span>
        <h2>{t.noResults}</h2>
        <p>{t.noResultsBody}</p>
        <button type="button" data-clear-filters>{t.clear}</button>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-catalog]');
  const searchForm = document.querySelector<HTMLFormElement>('[data-catalog-search]');
  const searchInput = searchForm?.querySelector<HTMLInputElement>('input[name="q"]');
  const resultContainer = root?.querySelector<HTMLElement>('[data-results]');
  const count = root?.querySelector<HTMLElement>('[data-result-count]');
  const empty = root?.querySelector<HTMLElement>('[data-empty]');
  const active = root?.querySelector<HTMLElement>('[data-active-filters]');
  const sort = root?.querySelector<HTMLSelectElement>('[data-sort]');
  const rows = [...(root?.querySelectorAll<HTMLElement>('[data-plugin-row]') ?? [])];
  const originalOrder = new Map(rows.map((row, index) => [row, index]));

  function selected(name: string): string[] {
    return [
      ...(root?.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`) ?? []),
    ].map((input) => input.value);
  }

  function setFromUrl() {
    const params = new URLSearchParams(location.search);
    if (searchInput) searchInput.value = params.get('q') ?? '';
    for (const name of ['type', 'category', 'availability', 'provenance']) {
      const values = params
        .getAll(name)
        .flatMap((value) => value.split(','))
        .filter(Boolean);
      for (const input of root?.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`) ?? []) {
        input.checked = values.includes(input.value);
      }
    }
  }

  function render() {
    const query = searchInput?.value.trim().toLocaleLowerCase() ?? '';
    const types = selected('type');
    const categories = selected('category');
    const availability = selected('availability');
    const provenance = selected('provenance');
    let visible = 0;

    for (const row of rows) {
      const match =
        (!query || row.dataset.search?.includes(query)) &&
        (!types.length || types.includes(row.dataset.type ?? '')) &&
        (!categories.length || categories.includes(row.dataset.category ?? '')) &&
        (!availability.length || availability.includes(row.dataset.availability ?? '')) &&
        (!provenance.length || provenance.includes(row.dataset.provenance ?? ''));
      row.hidden = !match;
      if (match) visible += 1;
    }

    const sorted = [...rows].sort((left, right) => {
      if (sort?.value === 'name')
        return (left.dataset.name ?? '').localeCompare(right.dataset.name ?? '');
      if (sort?.value === 'type')
        return (left.dataset.type ?? '').localeCompare(right.dataset.type ?? '');
      return (originalOrder.get(left) ?? 0) - (originalOrder.get(right) ?? 0);
    });
    for (const row of sorted) resultContainer?.append(row);

    if (count) count.textContent = String(visible);
    if (empty) empty.hidden = visible !== 0;

    const params = new URLSearchParams();
    if (query) params.set('q', query);
    for (const [name, values] of [
      ['type', types],
      ['category', categories],
      ['availability', availability],
      ['provenance', provenance],
    ] as const) {
      if (values.length) params.set(name, values.join(','));
    }
    const next = params.size ? `${location.pathname}?${params}` : location.pathname;
    history.replaceState({}, '', next);

    if (active) {
      active.replaceChildren();
      const values = [query, ...types, ...categories, ...availability, ...provenance].filter(
        Boolean,
      );
      for (const value of values) {
        const chip = document.createElement('span');
        chip.textContent = value;
        active.append(chip);
      }
    }
  }

  setFromUrl();
  render();
  searchForm?.addEventListener('submit', (event) => event.preventDefault());
  searchInput?.addEventListener('input', render);
  root?.addEventListener('change', render);
  sort?.addEventListener('change', render);
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-clear-filters]')) {
    button.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      for (const input of root?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]') ??
        []) {
        input.checked = false;
      }
      if (sort) sort.value = 'featured';
      render();
      searchInput?.focus();
    });
  }

  for (const element of document.querySelectorAll<HTMLElement>('[data-install-count]')) {
    const slug = element.dataset.installCount;
    if (!slug) continue;
    fetch(`/api/plugins/${encodeURIComponent(slug)}/stats`)
      .then((response) =>
        response.ok ? response.json() : Promise.reject(new Error('stats unavailable')),
      )
      .then((data: { total?: number }) => {
        element.textContent = new Intl.NumberFormat().format(data.total ?? 0);
      })
      .catch(() => undefined);
  }
</script>

<style>
  .catalog-search-band {
    background: var(--color-navy-900);
    border-top: 1px solid rgb(255 255 255 / 5%);
    padding: 2rem 0 2.35rem;
  }

  .catalog-search-band :global(.eyebrow) {
    color: var(--color-blue-300);
    margin: 0 0 0.7rem;
  }

  .catalog-search {
    align-items: center;
    background: rgb(255 255 255 / 12%);
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: var(--radius-medium);
    color: #b9c6d4;
    display: flex;
    height: 54px;
    max-width: 820px;
    padding: 0 1rem;
  }

  .catalog-search:focus-within {
    border-color: var(--color-blue-300);
  }

  .catalog-search input {
    background: transparent;
    border: 0;
    color: white;
    flex: 1;
    font-size: 1.04rem;
    outline: 0;
    padding: 0 0.8rem;
  }

  .catalog-search input::placeholder {
    color: #a8b6c7;
  }

  .catalog-search kbd {
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 3px;
    font-size: 0.7rem;
    padding: 0.08rem 0.35rem;
  }

  .catalog-layout {
    align-items: start;
    display: grid;
    gap: 3rem;
    grid-template-columns: 205px minmax(0, 1fr);
    padding-top: 2.2rem;
  }

  .filter-rail {
    position: sticky;
    top: 1.5rem;
  }

  .filter-heading {
    align-items: center;
    border-bottom: 1px solid var(--color-rule-strong);
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.75rem;
  }

  .filter-heading span {
    align-items: center;
    display: flex;
    font-size: 0.78rem;
    font-weight: 570;
    gap: 0.45rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .filter-heading button,
  .empty-results button {
    background: transparent;
    border: 0;
    color: var(--color-accent);
    cursor: pointer;
    font-size: 0.72rem;
    padding: 0.35rem 0;
  }

  fieldset {
    border: 0;
    border-bottom: 1px solid var(--color-rule);
    margin: 0;
    padding: 1rem 0;
  }

  legend {
    font-size: 0.78rem;
    font-weight: 560;
    margin-bottom: 0.65rem;
    padding: 0;
  }

  fieldset label {
    align-items: center;
    color: var(--color-text-muted);
    cursor: pointer;
    display: grid;
    font-size: 0.83rem;
    gap: 0.55rem;
    grid-template-columns: 16px 1fr auto;
    min-height: 33px;
  }

  fieldset input {
    accent-color: var(--color-accent);
    height: 15px;
    margin: 0;
    width: 15px;
  }

  fieldset small {
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .results-toolbar {
    align-items: center;
    border-bottom: 1px solid var(--color-rule-strong);
    display: flex;
    justify-content: space-between;
    min-height: 52px;
  }

  .results-toolbar h1 {
    font-size: 0.8rem;
    font-weight: 430;
    letter-spacing: 0.035em;
    margin: 0;
    text-transform: uppercase;
  }

  .results-toolbar h1 strong {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    padding: 0.15rem 0.34rem;
  }

  .results-toolbar label {
    align-items: center;
    display: flex;
    font-size: 0.72rem;
    gap: 0.4rem;
    text-transform: uppercase;
  }

  .results-toolbar select {
    background: transparent;
    border: 0;
    color: var(--color-accent);
    cursor: pointer;
    font-size: 0.72rem;
    outline: 0;
    text-transform: uppercase;
  }

  .community-policy {
    background: var(--color-surface-subtle);
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.55;
    margin: 0;
    padding: 0.8rem 0.9rem;
  }

  .community-policy strong {
    color: var(--color-text);
  }

  .active-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    min-height: 0;
  }

  .active-filters:not(:empty) {
    border-bottom: 1px solid var(--color-rule);
    padding: 0.7rem 0;
  }

  .active-filters :global(span) {
    background: var(--color-accent-soft);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-small);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.2rem 0.4rem;
  }

  .empty-results {
    border-bottom: 1px solid var(--color-rule);
    padding: 5rem 1rem;
    text-align: center;
  }

  .empty-results > span {
    color: var(--color-rule-strong);
    font-family: var(--font-mono);
    font-size: 2rem;
  }

  .empty-results h2 {
    font-size: 1.2rem;
    margin: 1rem 0 0.4rem;
  }

  .empty-results p {
    color: var(--color-text-muted);
    margin: 0;
  }

  .empty-results button {
    font-size: 0.85rem;
    margin-top: 1rem;
  }

  @media (max-width: 820px) {
    .catalog-layout {
      gap: 1.5rem;
      grid-template-columns: 1fr;
    }

    .filter-rail {
      display: grid;
      gap: 0 1.2rem;
      grid-template-columns: repeat(3, 1fr);
      position: static;
    }

    .filter-heading {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .catalog-search-band {
      padding: 1.4rem 0 1.6rem;
    }

    .catalog-search {
      height: 48px;
    }

    .filter-rail {
      grid-template-columns: 1fr;
    }

    .results-toolbar label > span {
      display: none;
    }
  }
</style>
