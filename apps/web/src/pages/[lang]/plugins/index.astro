---
import CatalogCard from '../../../components/CatalogCard.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Icon from '../../../components/Icon.astro';
import { catalogCard, catalogListItems, initialCatalogCount } from '../../../lib/catalog-list.js';
import { displayName } from '../../../lib/catalog-types.js';
import { marketplaceEntries } from '../../../lib/catalog.js';
import { ecosystemCategories, ecosystemEntries } from '../../../lib/ecosystem.js';
import { copy, isLocale, locales } from '../../../lib/i18n.js';
import { normalizeAdSenseSlotId } from '../../../lib/adsense.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang;
if (!isLocale(locale)) throw new Error(`Unsupported locale: ${locale}`);
const t = copy[locale];
const catalogSlot = normalizeAdSenseSlotId(import.meta.env.PUBLIC_ADSENSE_SLOT_CATALOG);
const catalogCount = catalogListItems.length;
const starsByRepository = new Map(
  ecosystemEntries.map((entry) => [entry.sourceRepository.toLocaleLowerCase(), entry.stars]),
);
const initialCards = catalogListItems
  .slice(0, initialCatalogCount)
  .map((item) => catalogCard(item, locale, starsByRepository));
const registryUrl = `https://dsh.pub/${locale}/plugins/`;
const ui =
  locale === 'zh'
    ? {
        coordinate: 'DSH / PLUGINS',
        search: '按插件名、作者、能力、Tool 或仓库搜索…',
        shown: '条结果',
        all: '全部',
        quickUseCases: '按使用场景',
        sortStars: 'Stars',
        sortUpdated: '最近更新',
        more: '加载更多',
        loading: '加载中…',
        failed: '目录索引暂时不可用。',
        concepts: '这些标签是什么意思？',
      }
    : {
        coordinate: 'DSH / PLUGINS',
        search: 'Search by plugin, author, capability, tool, or repository…',
        shown: 'results',
        all: 'All',
        quickUseCases: 'Browse by use case',
        sortStars: 'Stars',
        sortUpdated: 'Recently updated',
        more: 'Load more',
        loading: 'Loading…',
        failed: 'Catalog index temporarily unavailable.',
        concepts: 'What do these labels mean?',
      };
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: t.registryHeading,
    url: registryUrl,
    description: t.registryPageDescription,
    inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
    isPartOf: { '@type': 'WebSite', name: 'dsh.pub', url: `https://dsh.pub/${locale}/` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: marketplaceEntries.length,
      itemListElement: marketplaceEntries.slice(0, 50).map((entry, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: displayName(entry),
        url: `https://dsh.pub/${locale}/plugins/${entry.slug}/`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: locale === 'zh' ? '首页' : 'Home',
        item: `https://dsh.pub/${locale}/`,
      },
      { '@type': 'ListItem', position: 2, name: t.registryHeading, item: registryUrl },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  title={t.registryPageTitle}
  description={t.registryPageDescription}
  showHeaderSearch={false}
  structuredData={structuredData}
>
  <section class="catalog-masthead">
    <div class="page-shell">
      <p class="eyebrow">{ui.coordinate}</p>
      <h1>{t.registryHeading}</h1>
      <p class="registry-guide-title">{t.registryGuideTitle}</p>
      <p>{t.registryLead}</p>
      <p class="concepts-link">
        <a href={`/${locale}/guide/`}>{ui.concepts}</a>
      </p>
    </div>
  </section>

  <main
    class="catalog-shell page-shell"
    data-catalog
    data-index-url={`/${locale}/catalog.json`}
    data-page-size={initialCatalogCount}
  >
    <section class="catalog-controls" aria-label={t.filters}>
      <form class="catalog-search" role="search" data-catalog-search>
        <Icon name="search" size={20} />
        <input
          type="search"
          name="q"
          aria-label={t.search}
          placeholder={ui.search}
          autocomplete="off"
        />
        <kbd>/</kbd>
        <span><strong data-result-count>{catalogCount}</strong> {ui.shown}</span>
      </form>
    </section>

    <nav class="use-case-filters" aria-label={ui.quickUseCases}>
      <span>{ui.quickUseCases}</span>
      <button type="button" class="active" data-category-filter="">{ui.all}</button>
      {
        ecosystemCategories.slice(0, 8).map(({ category, count }) => (
          <button type="button" data-category-filter={category}>
            {category}
            <small>{count}</small>
          </button>
        ))
      }
    </nav>

    <div class="results-toolbar">
      <label>
        <span>{t.sort}</span>
        <select data-sort>
          <option value="featured">{t.sortFeatured}</option>
          <option value="name">{t.sortName}</option>
          <option value="stars">{ui.sortStars}</option>
          <option value="updated">{ui.sortUpdated}</option>
          <option value="type">{t.sortType}</option>
        </select>
      </label>
    </div>

    <div class="active-filters" data-active-filters aria-live="polite"></div>
    <section class="catalog-grid" data-results aria-label={t.browse}>
      {initialCards.map((card) => <CatalogCard card={card} locale={locale} />)}
    </section>

    <div class="catalog-foot">
      <button
        type="button"
        data-catalog-more
        data-label={ui.more}
        data-loading={ui.loading}
        data-failed={ui.failed}
      >
        {ui.more}
      </button>
      <span data-catalog-status aria-live="polite"></span>
    </div>

    {catalogSlot && <AdSlot locale={locale} unit={catalogSlot} class="catalog-ad" />}

    <div class="empty-results" data-empty hidden>
      <span aria-hidden="true">0×00</span>
      <h2>{t.noResults}</h2>
      <p>{t.noResultsBody}</p>
      <button type="button" data-clear-filters>{t.clear}</button>
    </div>
  </main>
</BaseLayout>

<script>
  type CatalogRow = readonly [
    number,
    string,
    string,
    string,
    string,
    number,
    string,
    string,
    string,
    number,
    string,
  ];

  interface CatalogIndex {
    total: number;
    modes: string[];
    modeLabels: string[];
    rows: CatalogRow[];
  }

  const root = document.querySelector<HTMLElement>('[data-catalog]');
  const searchForm = document.querySelector<HTMLFormElement>('[data-catalog-search]');
  const searchInput = searchForm?.querySelector<HTMLInputElement>('input[name="q"]');
  const resultContainer = root?.querySelector<HTMLElement>('[data-results]');
  const count = root?.querySelector<HTMLElement>('[data-result-count]');
  const empty = root?.querySelector<HTMLElement>('[data-empty]');
  const active = root?.querySelector<HTMLElement>('[data-active-filters]');
  const sort = root?.querySelector<HTMLSelectElement>('[data-sort]');
  const moreButton = root?.querySelector<HTMLButtonElement>('[data-catalog-more]');
  const status = root?.querySelector<HTMLElement>('[data-catalog-status]');
  const categoryButtons = [
    ...(root?.querySelectorAll<HTMLButtonElement>('[data-category-filter]') ?? []),
  ];
  const pageSize = Number(root?.dataset.pageSize ?? 60);
  const indexUrl = root?.dataset.indexUrl ?? '';
  let category = '';
  let rendered = pageSize;
  let index: CatalogIndex | undefined;
  let indexPromise: Promise<CatalogIndex | undefined> | undefined;

  function freshness(value = ''): number {
    if (value === 'today') return 0;
    const days = /^(\d+)d ago$/u.exec(value);
    if (days) return Number(days[1]);
    const months = /^(\d+)mo ago$/u.exec(value);
    if (months) return Number(months[1]) * 31;
    const years = /^(\d+)y ago$/u.exec(value);
    if (years) return Number(years[1]) * 365;
    if (value === 'registry') return 1;
    return 9999;
  }

  function escape(value: string): string {
    return value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function cardMarkup(row: CatalogRow, data: CatalogIndex): string {
    const [
      origin,
      ,
      href,
      name,
      description,
      mode,
      categoryValue,
      provenance,
      search,
      stars,
      updated,
    ] = row;
    const external = origin === 1 ? ' rel="ugc nofollow noopener"' : '';
    const star = stars > 0 ? `<b>★ ${stars.toLocaleString()}</b>` : '';
    return `<a class="catalog-card" href="${escape(href)}"${external} data-catalog-item data-origin="${origin === 0 ? 'registry' : 'ecosystem'}" data-mode="${escape(data.modes[mode] ?? '')}" data-category="${escape(categoryValue)}" data-provenance="${escape(provenance)}" data-search="${escape(search)}" data-name="${escape(name.toLocaleLowerCase())}" data-stars="${stars}" data-updated="${escape(updated)}"><strong>${escape(name)}</strong><span>${escape(description)}</span><em>${escape(data.modeLabels[mode] ?? '')}${star}</em></a>`;
  }

  function setActiveButtons() {
    for (const button of categoryButtons) {
      button.classList.toggle('active', (button.dataset.categoryFilter ?? '') === category);
    }
  }

  function setFromUrl() {
    const params = new URLSearchParams(location.search);
    if (searchInput) searchInput.value = params.get('q') ?? '';
    category = params.get('category') ?? '';
    if (sort) sort.value = params.get('sort') ?? 'featured';
    setActiveButtons();
  }

  async function loadIndex(): Promise<CatalogIndex | undefined> {
    if (index) return index;
    if (indexPromise) return indexPromise;
    if (!moreButton) return undefined;
    moreButton.disabled = true;
    moreButton.textContent = moreButton.dataset.loading ?? 'Loading…';
    indexPromise = fetch(indexUrl)
      .then(async (response) => {
        if (!response.ok) throw new Error(`catalog index unavailable: ${response.status}`);
        index = (await response.json()) as CatalogIndex;
        return index;
      })
      .catch(() => {
        if (moreButton) moreButton.hidden = true;
        if (status) status.textContent = moreButton?.dataset.failed ?? '';
        return undefined;
      })
      .finally(() => {
        if (moreButton) {
          moreButton.disabled = false;
          moreButton.textContent = moreButton.dataset.label ?? 'Load more';
        }
      });
    return indexPromise;
  }

  function matchingRows(data: CatalogIndex): CatalogRow[] {
    const query = searchInput?.value.trim().toLocaleLowerCase() ?? '';
    let rows = data.rows.filter((row) => {
      const [, , , , , , categoryValue, , search] = row;
      return (!query || search.includes(query)) && (!category || categoryValue === category);
    });

    const sortValue = sort?.value ?? 'featured';
    if (sortValue === 'name') {
      rows = [...rows].sort((left, right) => left[3].localeCompare(right[3]));
    } else if (sortValue === 'type') {
      rows = [...rows].sort((left, right) => left[5] - right[5]);
    } else if (sortValue === 'stars') {
      rows = [...rows].sort((left, right) => right[9] - left[9]);
    } else if (sortValue === 'updated') {
      rows = [...rows].sort((left, right) => freshness(left[10]) - freshness(right[10]));
    }
    return rows;
  }

  function paint(data: CatalogIndex) {
    if (!resultContainer) return;
    const rows = matchingRows(data);
    const slice = rows.slice(0, rendered);
    resultContainer.innerHTML = slice.map((row) => cardMarkup(row, data)).join('');
    if (count) count.textContent = String(rows.length);
    if (empty) empty.hidden = rows.length !== 0;
    if (moreButton) moreButton.hidden = slice.length >= rows.length;
    if (status) {
      status.textContent = rows.length
        ? `${slice.length.toLocaleString()} / ${rows.length.toLocaleString()}`
        : '';
    }

    const params = new URLSearchParams();
    const query = searchInput?.value.trim() ?? '';
    if (query) params.set('q', query);
    if (category) params.set('category', category);
    if (sort?.value && sort.value !== 'featured') params.set('sort', sort.value);
    history.replaceState({}, '', `${location.pathname}?${params}`);

    if (active) {
      active.replaceChildren();
      for (const value of [query, category].filter(Boolean)) {
        const chip = document.createElement('span');
        chip.textContent = value;
        active.append(chip);
      }
    }
  }

  async function render(options: { resetPage?: boolean } = {}) {
    if (options.resetPage) rendered = pageSize;
    const query = searchInput?.value.trim() ?? '';
    const needsIndex =
      Boolean(query) ||
      Boolean(category) ||
      (sort?.value && sort.value !== 'featured') ||
      rendered > pageSize ||
      index;

    if (!needsIndex) {
      if (count) count.textContent = count.dataset.total ?? '';
      if (empty) empty.hidden = true;
      if (moreButton) moreButton.hidden = false;
      if (status) status.textContent = '';
      return;
    }

    const data = await loadIndex();
    if (data) paint(data);
  }

  if (count) count.dataset.total = count.textContent ?? '';

  setFromUrl();
  void render({ resetPage: true });
  searchForm?.addEventListener('submit', (event) => event.preventDefault());
  searchInput?.addEventListener('input', () => void render({ resetPage: true }));
  sort?.addEventListener('change', () => void render({ resetPage: true }));
  for (const button of categoryButtons) {
    button.addEventListener('click', () => {
      category = button.dataset.categoryFilter ?? '';
      setActiveButtons();
      void render({ resetPage: true });
    });
  }
  moreButton?.addEventListener('click', async () => {
    rendered += pageSize * 2;
    const data = await loadIndex();
    if (data) paint(data);
  });
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-clear-filters]')) {
    button.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (sort) sort.value = 'featured';
      category = '';
      setActiveButtons();
      void render({ resetPage: true });
      searchInput?.focus();
    });
  }
  document.addEventListener('keydown', (event) => {
    if (event.key === '/' && document.activeElement !== searchInput) {
      event.preventDefault();
      searchInput?.focus();
    }
  });
</script>

<style>
  .catalog-masthead {
    background: var(--color-navy-900);
    border-top: 1px solid rgb(255 255 255 / 5%);
    color: white;
    padding: 3.5rem 0 5.5rem;
  }

  .catalog-masthead :global(.eyebrow) {
    color: var(--color-blue-300);
    margin: 0 0 0.8rem;
  }

  .catalog-masthead h1 {
    font-size: clamp(2.5rem, 5vw, 4.3rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1;
    margin: 0;
  }

  .catalog-masthead .registry-guide-title {
    color: var(--color-blue-300);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    margin: 1rem 0 0;
    text-transform: uppercase;
  }

  .catalog-masthead p:not(.concepts-link) {
    color: #c4d0de;
    line-height: 1.6;
    margin: 1.1rem 0 0;
    max-width: 780px;
  }

  .concepts-link {
    margin: 1.2rem 0 0;
  }

  .concepts-link a {
    color: var(--color-blue-300);
    font-size: 0.86rem;
  }

  .catalog-shell {
    margin-top: -2.35rem;
    position: relative;
  }

  .catalog-controls {
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    box-shadow: var(--shadow-menu);
    overflow: hidden;
  }

  .catalog-search {
    align-items: center;
    color: var(--color-text-faint);
    display: grid;
    gap: 0.75rem;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    min-height: 68px;
    padding: 0.7rem 1rem;
  }

  .catalog-search input {
    background: transparent;
    border: 0;
    color: var(--color-text);
    font-size: 1rem;
    min-width: 0;
    outline: 0;
  }

  .catalog-search kbd {
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    color: var(--color-text-faint);
    font-size: 0.68rem;
    padding: 0.1rem 0.36rem;
  }

  .catalog-search > span {
    border-left: 1px solid var(--color-rule);
    color: var(--color-text-faint);
    font-size: 0.74rem;
    padding-left: 1rem;
    white-space: nowrap;
  }

  .catalog-search > span strong {
    color: var(--color-text);
    font-family: var(--font-mono);
  }

  .results-toolbar {
    align-items: end;
    display: flex;
    justify-content: flex-end;
    padding: 1.6rem 0 1rem;
  }

  .results-toolbar label {
    display: grid;
    gap: 0.25rem;
  }

  .results-toolbar label > span {
    color: var(--color-text-faint);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .results-toolbar select {
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 6px;
    color: var(--color-text);
    min-height: 38px;
    padding: 0 2rem 0 0.7rem;
  }

  .use-case-filters {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 1.2rem 0 0;
  }

  .use-case-filters > span {
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    margin-right: 0.3rem;
    text-transform: uppercase;
  }

  .use-case-filters button {
    background: transparent;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    color: var(--color-text-muted);
    cursor: pointer;
    font-size: 0.74rem;
    min-height: 34px;
    padding: 0 0.75rem;
  }

  .use-case-filters button.active {
    background: var(--color-accent-soft);
    border-color: color-mix(in srgb, var(--color-accent) 42%, var(--color-rule));
    color: var(--color-accent);
  }

  .use-case-filters button small {
    color: var(--color-text-faint);
    margin-left: 0.35rem;
  }

  .active-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    min-height: 0;
  }

  .active-filters:not(:empty) {
    margin-bottom: 1rem;
  }

  .active-filters span {
    background: var(--color-accent-soft);
    border: 1px solid color-mix(in srgb, var(--color-accent) 28%, var(--color-rule));
    border-radius: 999px;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    padding: 0.25rem 0.55rem;
  }

  .catalog-grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .catalog-foot {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: center;
    padding: 1.8rem 0 0.5rem;
  }

  .catalog-foot button {
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 7px;
    color: var(--color-text);
    cursor: pointer;
    min-height: 42px;
    padding: 0 1.1rem;
  }

  .catalog-foot button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .catalog-foot span {
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .empty-results {
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    margin-top: 1rem;
    padding: 4rem 1.5rem;
    text-align: center;
  }

  .empty-results > span {
    color: var(--color-accent);
    font-family: var(--font-mono);
  }

  .empty-results h2 {
    font-size: 1.4rem;
    margin: 0.8rem 0 0;
  }

  .empty-results p {
    color: var(--color-text-muted);
  }

  .empty-results button {
    background: var(--color-accent);
    border: 0;
    border-radius: 6px;
    color: white;
    cursor: pointer;
    min-height: 42px;
    padding: 0 1rem;
  }

  @media (max-width: 1060px) {
    .catalog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .catalog-masthead {
      padding: 2.8rem 0 4.8rem;
    }

    .catalog-search {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .catalog-search > span {
      border-left: 0;
      grid-column: 1 / -1;
      padding: 0 0 0.2rem 2rem;
    }

    .results-toolbar {
      align-items: stretch;
    }

    .results-toolbar select {
      width: 100%;
    }

    .catalog-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 500px) {
    .catalog-search {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }
  }
</style>
