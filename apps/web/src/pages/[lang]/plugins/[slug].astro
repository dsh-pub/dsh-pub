---
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';

import CopyCommand from '../../../components/CopyCommand.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Icon from '../../../components/Icon.astro';
import {
  displayName,
  installCommand,
  installMetricSlug,
  localized,
  provenanceStatus,
  seoDescription,
  sourceCoordinate,
  sourceUrl,
  type CatalogEntry,
} from '../../../lib/catalog-types.js';
import { marketplaceEntries } from '../../../lib/catalog.js';
import { categoryLabel, typeLabel } from '../../../lib/categories.js';
import { buildCapabilityTableRows } from '../../../lib/contribution-display.js';
import { normalizeAdSenseSlotId } from '../../../lib/adsense.js';
import { copy, locales, type Locale } from '../../../lib/i18n.js';
import { loadReadmeHtml, readmeContentUrl } from '../../../lib/readme.js';
import { localizedTopic, topicForEntry } from '../../../lib/topics.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    marketplaceEntries.map((entry) => ({
      params: { lang: locale, slug: entry.slug },
      props: { entry, locale },
    })),
  );
}

interface Props {
  entry: CatalogEntry;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const t = copy[locale];
const detailSlot = normalizeAdSenseSlotId(import.meta.env.PUBLIC_ADSENSE_SLOT_DETAIL);
const description = localized(entry.description, locale);
const rawDescription = await marked.parseInline(description, { gfm: true });
const descriptionHtml = sanitizeHtml(rawDescription, {
  allowedTags: ['a', 'br', 'code', 'del', 'em', 'strong'],
  allowedAttributes: { a: ['href', 'target', 'rel'] },
  allowedSchemes: ['https', 'http'],
  transformTags: {
    a: sanitizeHtml.simpleTransform('a', { rel: 'nofollow noopener noreferrer' }, true),
  },
});
const hasLongDescription = description.length > (locale === 'zh' ? 300 : 520);
const metaDescription = seoDescription(entry, locale);
const source = sourceUrl(entry);
const sourceName = sourceCoordinate(entry);
const provenance = provenanceStatus(entry);
const provenanceLabel =
  provenance === 'community-reviewed'
    ? t.communityReviewed
    : provenance === 'community-submitted'
      ? t.communitySubmitted
      : provenance === 'community-automated'
        ? t.communityAutomated
        : t.builtInSource;
const sourceRel = provenance === 'built-in' ? undefined : 'ugc';
const topic = topicForEntry(entry);
const command = installCommand(entry);
const distributionNote = localized(entry.distribution.note, locale);
const provenanceStatement =
  entry.provenance?.status === 'community-reviewed' ||
  entry.provenance?.status === 'community-submitted' ||
  entry.provenance?.status === 'community-automated'
    ? localized(entry.provenance.statement, locale)
    : t.builtInSourceHelp;
const readmeSource = readmeContentUrl(entry, locale);
const readme = await loadReadmeHtml(entry, locale);
const limitationRaw = localized(entry.docs?.limitations, locale);
const limitation =
  limitationRaw &&
  !/未核对|not inspected|自动提交检查未核对|not inspected by the automated/i.test(limitationRaw)
    ? limitationRaw
    : '';
const tools = entry.capabilities.tools;
const uiContributions = entry.capabilities.uiContributions;
const capabilityRows = buildCapabilityTableRows({
  locale,
  tools,
  uiContributions,
});
const hasContributions = capabilityRows.length > 0;
const metricSlug = entry.distribution.installable ? installMetricSlug(entry) : undefined;
const canonical = `https://dsh.pub/${locale}/plugins/${entry.slug}/`;
const inLanguage = locale === 'zh' ? 'zh-CN' : 'en';
const pageTitle =
  locale === 'zh'
    ? `${displayName(entry)}：DeepSeek Harness 插件`
    : `${displayName(entry)} — DeepSeek Harness plugin`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: displayName(entry),
    description: metaDescription,
    url: canonical,
    codeRepository: source,
    version: entry.version,
    license: entry.license,
    runtimePlatform: 'DeepSeek Harness',
    inLanguage,
    isPartOf: { '@type': 'WebSite', name: 'dsh.pub', url: `https://dsh.pub/${locale}/` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: locale === 'zh' ? '首页' : 'Home',
        item: `https://dsh.pub/${locale}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: t.plugins,
        item: `https://dsh.pub/${locale}/plugins/`,
      },
      { '@type': 'ListItem', position: 3, name: displayName(entry), item: canonical },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={metaDescription}
  structuredData={structuredData}
>
  <section class="package-masthead">
    <div class="page-shell masthead-inner">
      <div class="package-identity">
        <a class="back-link" href={`/${locale}/plugins/`}>
          <Icon name="arrow" size={15} />{locale === 'zh' ? '全部插件' : 'All plugins'}
        </a>
        <p class="package-coordinate">
          DSH / {entry.type.toUpperCase()} / {entry.category.toUpperCase()}
        </p>
        <div class="package-title">
          <h1>{displayName(entry)}</h1>
          <button
            type="button"
            class="copy-package"
            title={`${t.copy} ${entry.name}`}
            data-copy-package={entry.name}
            ><Icon name="copy" size={17} /><span class="visually-hidden">{t.copy}</span></button
          >
        </div>
        <p class="package-meta">
          <span>v{entry.version}</span>
          <span aria-hidden="true">•</span>
          <a href={source} rel={sourceRel}>{sourceName.replace('/', ' / ')}</a>
          <span aria-hidden="true">•</span>
          <code>{entry.source.commit.slice(0, 10)}</code>
        </p>
        <div class="tag-row masthead-tags">
          <span class="tag primary">
            {
              entry.distribution.installable
                ? t.installable
                : entry.type === 'bundle'
                  ? t.profileLayer
                  : t.included
            }
          </span>
          <span class="tag">{typeLabel(entry.type, locale)}</span>
          <a class="tag" href={`/${locale}/categories/${topic.id}/`}>
            {localizedTopic(topic.label, locale)}
          </a>
          <span class="tag" title={provenanceStatement}>
            {provenanceLabel}
          </span>
          {entry.runtime.configurable && <span class="tag">{t.configurable}</span>}
          {entry.runtime.client && <span class="tag">{t.webUi}</span>}
        </div>
      </div>
      <div class="masthead-aside">
        <a class="masthead-source" href={source} rel={sourceRel}>
          <Icon name="github" size={17} />{t.openGitHub}<Icon name="external" size={14} />
        </a>
      </div>
    </div>
  </section>

  <nav class="package-tabs" aria-label="Package sections">
    <div class="page-shell tabs-inner">
      <a class="active" href="#overview">{t.overview}</a>
      {hasContributions && <a href="#capabilities">{t.capabilities}</a>}
      <a href="#installing">{entry.distribution.installable ? t.installing : t.availability}</a>
      <a href="#source">{t.sourceTab}</a>
    </div>
  </nav>

  <div class="package-layout page-shell">
    <article class="package-content">
      <section id="overview" class="content-section introduction">
        <p class="eyebrow">{t.overview}</p>
        <h2>{displayName(entry)}</h2>
        {
          hasLongDescription ? (
            <details class="technical-overview" data-technical-overview>
              <summary>
                <span class="technical-overview-label">{t.technicalOverview}</span>
                <span class="technical-overview-preview" set:html={descriptionHtml} />
                <span class="technical-overview-toggle">
                  <span class="toggle-expand">{t.expandTechnicalOverview}</span>
                  <span class="toggle-collapse">{t.collapseTechnicalOverview}</span>
                </span>
              </summary>
              <div class="technical-overview-body" set:html={descriptionHtml} />
            </details>
          ) : (
            <div class="lead" set:html={descriptionHtml} />
          )
        }
      </section>

      {
        hasContributions && (
          <section id="capabilities" class="content-section">
            <p class="eyebrow">{t.capabilities}</p>
            <table class="capability-table">
              <thead>
                <tr>
                  <th scope="col">{locale === 'zh' ? '能力' : 'Capability'}</th>
                  <th scope="col">{locale === 'zh' ? '内容' : 'Detail'}</th>
                </tr>
              </thead>
              <tbody>
                {capabilityRows.map((row) => (
                  <tr>
                    <th scope="row">
                      <button
                        type="button"
                        class="capability-kind"
                        aria-label={`${row.kindLabel}：${row.kindTooltip}`}
                        data-tooltip={row.kindTooltip}
                      >
                        {row.kindLabel}
                        <span class="capability-tip" aria-hidden="true">
                          ?
                        </span>
                      </button>
                    </th>
                    <td>
                      <span
                        class:list={['capability-value', { 'has-tip': Boolean(row.valueHint) }]}
                        data-tooltip={row.valueHint || undefined}
                      >
                        {row.kind === 'tool' ? <code>{row.value}</code> : row.value}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        )
      }

      <section class="content-section" id="readme">
        <p class="eyebrow">README / {locale.toUpperCase()}</p>
        <h2>{t.readme}</h2>
        {
          readme ? (
            <div class="readme-content" set:html={readme} />
          ) : (
            <div class="readme-fallback">
              <div set:html={descriptionHtml} />
              <p>
                {locale === 'zh'
                  ? '完整双语 README 位于源仓库。本目录页优先展示可自动验证的运行时与分发事实。'
                  : 'The complete bilingual README lives in the source repository. This registry page prioritizes runtime and distribution facts that can be verified automatically.'}
              </p>
              <a
                class="text-link"
                href={
                  readmeSource.replace(
                    /^https:\/\/raw\.githubusercontent\.com\/([^/]+)\/([^/]+)\/([^/]+)\/(.+)$/i,
                    'https://github.com/$1/$2/blob/$3/$4',
                  ) || `${source}/README${locale === 'zh' ? '.zh' : ''}.md`
                }
                rel={sourceRel}
              >
                {t.openGitHub}
                <Icon name="external" size={15} />
              </a>
            </div>
          )
        }
      </section>

      {
        limitation && (
          <section class="content-section limitation-section">
            <p class="eyebrow">LIMITATIONS</p>
            <h2>{t.limitations}</h2>
            <p>{limitation}</p>
          </section>
        )
      }
    </article>

    <aside class="package-sidebar" aria-label="Package metadata">
      {
        entry.distribution.installable ? (
          <section class="install-panel" id="installing">
            <span class="eyebrow">{t.install}</span>
            <h2>{locale === 'zh' ? '从 GitHub 安装' : 'Install from GitHub'}</h2>
            <p>{t.installHelp}</p>
            {command && <CopyCommand command={command} locale={locale} />}
            <div class="install-metric">
              <strong data-detail-install-count={metricSlug}>—</strong>
              <span>{t.cliInstalls}</span>
            </div>
            <p class="install-metric-help">{t.cliInstallsHelp}</p>
          </section>
        ) : (
          <section class="install-panel included-panel" id="installing">
            <span class="eyebrow">{t.availability}</span>
            <span class="coordinate">
              {entry.type === 'bundle' ? 'BUILT-IN / PROFILE LAYER' : 'BUILT-IN / ATOMIC'}
            </span>
            <div class="included-status">
              <Icon name="check" size={18} />
              <div>
                <h2>{entry.type === 'bundle' ? t.builtInProfileTitle : t.builtInModuleTitle}</h2>
                <p>{distributionNote || t.builtInNotice}</p>
              </div>
            </div>
          </section>
        )
      }

      <section>
        <h2>{t.source}</h2>
        <dl>
          <div><dt>{t.version}</dt><dd>{entry.version}</dd></div>
          <div><dt>{t.license}</dt><dd>{entry.license}</dd></div>
          <div><dt>{t.type}</dt><dd>{typeLabel(entry.type, locale)}</dd></div>
          <div><dt>{t.capability}</dt><dd>{categoryLabel(entry.category, locale)}</dd></div>
          <div>
            <dt>{t.sourceScope}</dt>
            <dd>{provenanceLabel}</dd>
          </div>
          <div><dt>Commit</dt><dd><code>{entry.source.commit.slice(0, 10)}</code></dd></div>
          <div><dt>Path</dt><dd><code>{entry.source.directory || '.'}</code></dd></div>
        </dl>
        <a class="source-button" href={source} id="source" rel={sourceRel}>
          <Icon name="github" size={17} />{t.openGitHub}<Icon name="external" size={14} />
        </a>
      </section>

      {
        entry.availability.profiles !== null && (
          <section>
            <h2>{t.profiles}</h2>
            <div class="tag-row">
              {entry.availability.profiles.length > 0 ? (
                entry.availability.profiles.map((profile) => (
                  <span class="tag primary">{profile}</span>
                ))
              ) : (
                <span class="tag">{t.included}</span>
              )}
            </div>
          </section>
        )
      }

      {detailSlot && <AdSlot locale={locale} unit={detailSlot} class="detail-ad" />}
    </aside>
  </div>
</BaseLayout>

<script>
  const copyPackageButton = document.querySelector<HTMLButtonElement>('[data-copy-package]');
  copyPackageButton?.addEventListener('click', async () => {
    const value = copyPackageButton.dataset.copyPackage;
    if (value) await navigator.clipboard.writeText(value);
  });

  const installCount = document.querySelector<HTMLElement>('[data-detail-install-count]');
  const slug = installCount?.dataset.detailInstallCount;
  if (installCount && slug) {
    fetch(`/api/plugins/${encodeURIComponent(slug)}/stats`)
      .then((response) =>
        response.ok ? response.json() : Promise.reject(new Error('stats unavailable')),
      )
      .then((data: { total?: number }) => {
        installCount.textContent = new Intl.NumberFormat().format(data.total ?? 0);
      })
      .catch(() => undefined);
  }
</script>

<style>
  .package-masthead {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-text);
    max-width: 100%;
    overflow-x: clip;
    padding: 2.8rem 0 3.2rem;
  }

  .package-identity {
    max-width: 100%;
    min-width: 0;
  }

  .masthead-inner {
    align-items: center;
    display: grid;
    gap: 3rem;
    grid-template-columns: minmax(0, 1fr) minmax(330px, 470px);
  }

  .package-coordinate {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    margin: 1.25rem 0 0.85rem;
  }

  .back-link {
    align-items: center;
    color: var(--color-text-faint);
    display: inline-flex;
    font-size: 0.8rem;
    gap: 0.45rem;
  }

  .back-link :global(.icon) {
    transform: rotate(180deg);
  }

  .package-title {
    align-items: center;
    display: flex;
    gap: 0.8rem;
  }

  .package-title h1 {
    font-size: clamp(1.85rem, 4vw, 3.1rem);
    font-weight: 560;
    letter-spacing: -0.045em;
    line-height: 1.06;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .copy-package {
    background: transparent;
    border: 0;
    color: var(--color-text-faint);
    cursor: pointer;
    padding: 0.55rem;
  }

  .package-meta {
    align-items: center;
    color: var(--color-text-faint);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.82rem;
    gap: 0.55rem;
    margin: 1rem 0;
  }

  .package-meta a {
    color: var(--color-accent);
  }

  .masthead-aside {
    display: grid;
    gap: 1rem;
  }

  .masthead-source {
    align-items: center;
    background: var(--color-navy-950);
    border: 1px solid var(--color-navy-950);
    border-radius: 7px;
    color: white;
    display: inline-flex;
    font-size: 0.8rem;
    gap: 0.5rem;
    justify-self: end;
    min-height: 42px;
    padding: 0 0.9rem;
  }

  .masthead-source:hover {
    background: var(--color-navy-800);
    text-decoration: none;
  }

  .package-tabs {
    background: color-mix(in srgb, var(--color-surface) 94%, transparent);
    border-bottom: 1px solid var(--color-rule);
    position: sticky;
    top: 0;
    z-index: 8;
  }

  .tabs-inner {
    display: flex;
    gap: 2.3rem;
    min-height: 58px;
    overflow-x: auto;
  }

  .tabs-inner a {
    align-items: center;
    border-bottom: 2px solid transparent;
    color: var(--color-text-muted);
    display: flex;
    flex: none;
    font-size: 0.88rem;
    padding-top: 2px;
  }

  .tabs-inner a.active,
  .tabs-inner a:hover {
    border-bottom-color: var(--color-accent);
    color: var(--color-accent);
    text-decoration: none;
  }

  .package-layout {
    align-items: start;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1fr) 310px;
    max-width: 100%;
    min-width: 0;
    overflow-x: clip;
    padding-top: 2.7rem;
  }

  .package-content {
    max-width: 100%;
    min-width: 0;
  }

  .content-section {
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    margin-bottom: 1rem;
    padding: 1.6rem 1.7rem 1.8rem;
    scroll-margin-top: 1rem;
  }

  .content-section + .content-section {
    padding-top: 1.6rem;
  }

  .content-section h2 {
    font-size: clamp(1.55rem, 2.8vw, 2.2rem);
    font-weight: 460;
    letter-spacing: -0.04em;
    margin: 0.65rem 0 1.1rem;
  }

  .lead {
    color: var(--color-text-muted);
    font-size: 1.08rem;
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 52rem;
  }

  .lead :global(code),
  .technical-overview :global(code) {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-rule);
    border-radius: 3px;
    color: var(--color-text);
    font-size: 0.86em;
    overflow-wrap: anywhere;
    padding: 0.08em 0.3em;
  }

  .technical-overview {
    border-bottom: 1px solid var(--color-rule);
    border-top: 1px solid var(--color-rule);
    margin: 0 0 2rem;
  }

  .technical-overview summary {
    cursor: pointer;
    list-style: none;
    padding: 1rem 0 1.05rem;
  }

  .technical-overview summary::-webkit-details-marker {
    display: none;
  }

  .technical-overview-label {
    color: var(--color-text-faint);
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.07em;
    margin-bottom: 0.55rem;
    text-transform: uppercase;
  }

  .technical-overview-preview {
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    color: var(--color-text-muted);
    display: -webkit-box;
    font-size: 1.04rem;
    line-height: 1.72;
    max-width: 52rem;
    overflow: hidden;
  }

  .technical-overview-toggle {
    align-items: center;
    color: var(--color-accent);
    display: flex;
    font-family: var(--font-mono);
    font-size: 0.71rem;
    gap: 0.5rem;
    margin-top: 0.75rem;
    width: max-content;
  }

  .technical-overview-toggle::after {
    border-bottom: 1px solid currentColor;
    border-right: 1px solid currentColor;
    content: '';
    height: 6px;
    transform: rotate(45deg) translateY(-2px);
    transition: transform var(--transition-fast);
    width: 6px;
  }

  .technical-overview[open] .technical-overview-preview,
  .technical-overview:not([open]) .toggle-collapse {
    display: none;
  }

  .technical-overview[open] .toggle-expand {
    display: none;
  }

  .technical-overview[open] .technical-overview-toggle::after {
    transform: rotate(225deg) translate(-1px, -1px);
  }

  .technical-overview-body {
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-muted);
    font-size: 0.96rem;
    line-height: 1.75;
    margin: 0 0 1.25rem;
    max-width: 52rem;
    padding: 0.2rem 0 0.2rem 1rem;
  }

  .capability-table {
    border-collapse: collapse;
    margin-top: 0.35rem;
    overflow: visible;
    width: 100%;
  }

  .capability-table th,
  .capability-table td {
    border-top: 1px solid var(--color-rule);
    overflow: visible;
    padding: 0.85rem 0.75rem 0.85rem 0;
    text-align: left;
    vertical-align: top;
  }

  .capability-table thead th {
    border-top: 0;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    padding-bottom: 0.55rem;
    text-transform: uppercase;
  }

  .capability-table tbody th {
    color: var(--color-text);
    font-size: 0.92rem;
    font-weight: 560;
    width: 7.5rem;
  }

  .capability-kind {
    align-items: center;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: help;
    display: inline-flex;
    font: inherit;
    font-weight: 560;
    gap: 0.35rem;
    padding: 0;
    position: relative;
  }

  .capability-tip {
    align-items: center;
    border: 1px solid var(--color-rule-strong);
    border-radius: 999px;
    color: var(--color-text-faint);
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    height: 1rem;
    justify-content: center;
    line-height: 1;
    width: 1rem;
  }

  .capability-kind:hover .capability-tip,
  .capability-kind:focus-visible .capability-tip {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .capability-kind[data-tooltip]::after,
  .capability-value.has-tip[data-tooltip]::after {
    background: var(--color-navy-950);
    border-radius: 6px;
    color: #eef6ff;
    content: attr(data-tooltip);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 450;
    left: 0;
    letter-spacing: 0;
    line-height: 1.45;
    max-width: min(22rem, 70vw);
    opacity: 0;
    padding: 0.55rem 0.7rem;
    pointer-events: none;
    position: absolute;
    text-align: left;
    text-transform: none;
    top: calc(100% + 0.45rem);
    transform: translateY(-2px);
    transition:
      opacity 0.12s ease,
      transform 0.12s ease;
    white-space: normal;
    width: max-content;
    z-index: 5;
  }

  .capability-kind[data-tooltip]:hover::after,
  .capability-kind[data-tooltip]:focus-visible::after,
  .capability-value.has-tip[data-tooltip]:hover::after,
  .capability-value.has-tip[data-tooltip]:focus-visible::after {
