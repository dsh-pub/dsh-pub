---
import CatalogCard from '../../../components/CatalogCard.astro';
import Icon from '../../../components/Icon.astro';
import { catalogCard, catalogListItems, initialCatalogCount } from '../../../lib/catalog-list.js';
import { ecosystemEntries } from '../../../lib/ecosystem.js';
import { copy, locales, type Locale } from '../../../lib/i18n.js';
import { localizedTopic, registryTopics, type RegistryTopic } from '../../../lib/topics.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    registryTopics.map((topic) => ({
      params: { lang: locale, topic: topic.id },
      props: { locale, topic },
    })),
  );
}

interface Props {
  locale: Locale;
  topic: RegistryTopic;
}

const { locale, topic } = Astro.props;
const t = copy[locale];
const starsByRepository = new Map(
  ecosystemEntries.map((entry) => [entry.sourceRepository.toLocaleLowerCase(), entry.stars]),
);
const registryCards = catalogListItems
  .map((item) => catalogCard(item, locale, starsByRepository))
  .filter((card) => card.origin === 'registry');
const topicCards = registryCards.filter((card) => topic.sourceCategories.includes(card.category));
const initialCards = topicCards.slice(0, initialCatalogCount);
const topicCount = (candidate: RegistryTopic) =>
  registryCards.filter((card) => candidate.sourceCategories.includes(card.category)).length;
const label = localizedTopic(topic.label, locale);
const description = localizedTopic(topic.description, locale);
const selectionAdvice = localizedTopic(topic.selectionAdvice, locale);
const canonical = `https://dsh.pub/${locale}/categories/${topic.id}/`;
const topicCategories = topic.sourceCategories.join(',');
const loadMoreLabel = locale === 'zh' ? '加载更多' : 'Load more';
const loadingLabel = locale === 'zh' ? '加载中…' : 'Loading…';
const failedLabel =
  locale === 'zh' ? '目录索引暂时不可用。' : 'Catalog index temporarily unavailable.';
const pageTitle =
  locale === 'zh' ? `${label}：DeepSeek Harness 插件` : `${label} for DeepSeek Harness`;
const metaDescription = description;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: pageTitle,
    url: canonical,
    description: metaDescription,
    inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
    isPartOf: {
      '@type': 'WebSite',
      name: 'dsh.pub',
      url: `https://dsh.pub/${locale}/`,
    },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: topicCards.length,
      itemListElement: topicCards.slice(0, 50).map((card, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: card.name,
        url: `https://dsh.pub${card.href}`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: locale === 'zh' ? '首页' : 'Home',
        item: `https://dsh.pub/${locale}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: t.registryHeading,
        item: `https://dsh.pub/${locale}/plugins/`,
      },
      { '@type': 'ListItem', position: 3, name: label, item: canonical },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={metaDescription}
  structuredData={structuredData}
>
  <header class="topic-hero">
    <div class="page-shell">
      <p class="eyebrow">DSH / REGISTRY / {topic.id.toLocaleUpperCase()}</p>
      <h1>{label}</h1>
      <p>{description}</p>
      <div class="topic-actions">
        <a href={`/${locale}/plugins/`}>{t.viewAll}<Icon name="arrow" size={15} /></a>
        <a href={`/${locale}/submit/`}>{t.registryGuideSubmitLink}<Icon name="arrow" size={15} /></a
        >
      </div>
    </div>
  </header>

  <div class="topic-layout page-shell">
    <aside aria-label={locale === 'zh' ? '插件主题' : 'Plugin topics'}>
      <span>{locale === 'zh' ? '浏览主题' : 'Browse topics'}</span>
      <nav>
        {
          registryTopics.map((candidate) => (
            <a
              class:list={{ active: candidate.id === topic.id }}
              href={`/${locale}/categories/${candidate.id}/`}
              aria-current={candidate.id === topic.id ? 'page' : undefined}
            >
              {localizedTopic(candidate.label, locale)}
              <small>{topicCount(candidate)}</small>
            </a>
          ))
        }
      </nav>
    </aside>

    <section
      class="topic-results"
      id="topic-results"
      data-topic-catalog
      data-index-url={`/${locale}/catalog.json`}
      data-page-size={initialCatalogCount}
      data-topic-categories={topicCategories}
    >
      <div class="topic-summary">
        <div>
          <span>{locale === 'zh' ? '收录条目' : 'Catalog records'}</span>
          <strong>{topicCards.length}</strong>
        </div>
        <p>
          <strong>{locale === 'zh' ? '选择提示：' : 'Selection note: '}</strong>{selectionAdvice}
        </p>
      </div>
      <div class="topic-grid" data-topic-results>
        {initialCards.map((card) => <CatalogCard card={card} locale={locale} />)}
      </div>
      <div class="topic-foot">
        <button
          type="button"
          data-topic-more
          data-label={loadMoreLabel}
          data-loading={loadingLabel}
          data-failed={failedLabel}
          hidden={initialCards.length >= topicCards.length}
        >
          {loadMoreLabel}
        </button>
        <span data-topic-status aria-live="polite">
          {
            topicCards.length > initialCards.length &&
              `${initialCards.length.toLocaleString()} / ${topicCards.length.toLocaleString()}`
          }
        </span>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  type CatalogRow = readonly [
    number,
    string,
    string,
    string,
    string,
    number,
    string,
    string,
    string,
    number,
    string,
  ];

  interface CatalogIndex {
    total: number;
    modes: string[];
    modeLabels: string[];
    rows: CatalogRow[];
  }

  const root = document.querySelector<HTMLElement>('[data-topic-catalog]');
  const resultContainer = root?.querySelector<HTMLElement>('[data-topic-results]');
  const moreButton = root?.querySelector<HTMLButtonElement>('[data-topic-more]');
  const status = root?.querySelector<HTMLElement>('[data-topic-status]');
  const pageSize = Number(root?.dataset.pageSize ?? 24);
  const indexUrl = root?.dataset.indexUrl ?? '';
  const topicCategories = new Set(
    (root?.dataset.topicCategories ?? '')
      .split(',')
      .map((value) => value.trim())
      .filter(Boolean),
  );
  let rendered = pageSize;
  let index: CatalogIndex | undefined;
  let indexPromise: Promise<CatalogIndex | undefined> | undefined;

  function escape(value: string): string {
    return value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function cardMarkup(row: CatalogRow, data: CatalogIndex): string {
    const [
      origin,
      ,
      href,
      name,
      description,
      mode,
      categoryValue,
      provenance,
      search,
      stars,
      updated,
    ] = row;
    const external = origin === 1 ? ' rel="ugc nofollow noopener"' : '';
    const star = stars > 0 ? `<b>★ ${stars.toLocaleString()}</b>` : '';
    return `<a class="catalog-card" href="${escape(href)}"${external} data-catalog-item data-origin="${origin === 0 ? 'registry' : 'ecosystem'}" data-mode="${escape(data.modes[mode] ?? '')}" data-category="${escape(categoryValue)}" data-provenance="${escape(provenance)}" data-search="${escape(search)}" data-name="${escape(name.toLocaleLowerCase())}" data-stars="${stars}" data-updated="${escape(updated)}"><strong>${escape(name)}</strong><span>${escape(description)}</span><em>${escape(data.modeLabels[mode] ?? '')}${star}</em></a>`;
  }

  function topicRows(data: CatalogIndex): CatalogRow[] {
    return data.rows.filter((row) => row[0] === 0 && topicCategories.has(row[6]));
  }

  async function loadIndex(): Promise<CatalogIndex | undefined> {
    if (index) return index;
    if (indexPromise) return indexPromise;
    if (!moreButton) return undefined;
    moreButton.disabled = true;
    moreButton.textContent = moreButton.dataset.loading ?? 'Loading…';
    indexPromise = fetch(indexUrl)
      .then(async (response) => {
        if (!response.ok) throw new Error(`catalog index unavailable: ${response.status}`);
        index = (await response.json()) as CatalogIndex;
        return index;
      })
      .catch(() => {
        if (moreButton) moreButton.hidden = true;
        if (status) status.textContent = moreButton?.dataset.failed ?? '';
        return undefined;
      })
      .finally(() => {
        if (moreButton) {
          moreButton.disabled = false;
          moreButton.textContent = moreButton.dataset.label ?? 'Load more';
        }
      });
    return indexPromise;
  }

  function paint(data: CatalogIndex) {
    if (!resultContainer) return;
    const rows = topicRows(data);
    const slice = rows.slice(0, rendered);
    resultContainer.innerHTML = slice.map((row) => cardMarkup(row, data)).join('');
    if (moreButton) moreButton.hidden = slice.length >= rows.length;
    if (status) {
      status.textContent = rows.length
        ? `${slice.length.toLocaleString()} / ${rows.length.toLocaleString()}`
        : '';
    }
  }

  moreButton?.addEventListener('click', async () => {
    rendered += pageSize * 2;
    const data = await loadIndex();
    if (data) paint(data);
  });
</script>

<style>
  .topic-hero {
    background: var(--color-navy-900);
    color: white;
    padding: 3.6rem 0 3.8rem;
  }

  .topic-hero :global(.eyebrow) {
    color: var(--color-blue-300);
    margin: 0 0 0.8rem;
  }

  .topic-hero h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.7rem);
    font-weight: 440;
    letter-spacing: -0.05em;
    line-height: 1.03;
    margin: 0;
  }

  .topic-hero p:not(.eyebrow) {
    color: #c4d0de;
    line-height: 1.65;
    margin: 1rem 0 0;
    max-width: 760px;
  }

  .topic-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 1.4rem;
  }

  .topic-actions a {
    align-items: center;
    color: var(--color-blue-300);
    display: inline-flex;
    font-size: 0.83rem;
    gap: 0.4rem;
  }

  .topic-layout {
    align-items: start;
    display: grid;
    gap: 3rem;
    grid-template-columns: 220px minmax(0, 1fr);
    padding-bottom: 5rem;
    padding-top: 2.8rem;
  }

  .topic-layout aside {
    position: sticky;
    top: 1.5rem;
  }

  .topic-layout aside > span {
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .topic-layout nav {
    border-top: 1px solid var(--color-rule-strong);
    margin-top: 0.75rem;
  }

  .topic-layout nav a {
    align-items: center;
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-text-muted);
    display: flex;
    font-size: 0.82rem;
    justify-content: space-between;
    padding: 0.7rem 0.15rem;
  }

  .topic-layout nav a.active {
    color: var(--color-accent);
    font-weight: 570;
  }

  .topic-layout nav small {
    font-family: var(--font-mono);
  }

  .topic-summary {
    align-items: stretch;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-rule);
    display: grid;
    grid-template-columns: 150px 1fr;
    margin-bottom: 1rem;
  }

  .topic-summary > div {
    border-right: 1px solid var(--color-rule);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1rem;
  }

  .topic-summary span {
    color: var(--color-text-faint);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .topic-summary strong {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 500;
  }

  .topic-summary p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    padding: 1rem;
  }

  .topic-summary p strong {
    color: var(--color-text);
    font-family: inherit;
    font-size: inherit;
    font-weight: 570;
  }

  .topic-grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .topic-foot {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: center;
    padding: 1.8rem 0 0.5rem;
  }

  .topic-foot button {
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 7px;
    color: var(--color-text);
    cursor: pointer;
    min-height: 42px;
    padding: 0 1.1rem;
  }

  .topic-foot button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .topic-foot span {
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  @media (max-width: 760px) {
    .topic-layout {
      grid-template-columns: 1fr;
    }

    .topic-layout aside {
      position: static;
    }

    .topic-layout nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .topic-layout nav a:nth-child(odd) {
      margin-right: 1rem;
    }

    .topic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .topic-summary {
      grid-template-columns: 1fr;
    }

    .topic-summary > div {
      border-bottom: 1px solid var(--color-rule);
      border-right: 0;
    }

    .topic-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
