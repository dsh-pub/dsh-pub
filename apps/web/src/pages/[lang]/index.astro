---
import AdSlot from '../../components/AdSlot.astro';
import HarnessBackdrop from '../../components/HarnessBackdrop.astro';
import Icon from '../../components/Icon.astro';
import PluginTile from '../../components/PluginTile.astro';
import {
  browsableEntries,
  browseTile,
  browseTotals,
  browseUseCases,
  communityHighlights,
  initialTileCount,
  starsFor,
} from '../../lib/browse.js';
import { normalizeAdSenseSlotId } from '../../lib/adsense.js';
import { copy, isLocale, locales } from '../../lib/i18n.js';
import { useCaseLabel } from '../../lib/use-cases.js';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang;
if (!isLocale(locale)) throw new Error(`Unsupported locale: ${locale}`);
const t = copy[locale];

const highlights = communityHighlights.slice(0, 6);
const initialTiles = browsableEntries.slice(0, initialTileCount);
const installable = browseTotals.installable.toLocaleString();
const homeAdSlot = normalizeAdSenseSlotId(import.meta.env.PUBLIC_ADSENSE_SLOT_DETAIL);

const ui =
  locale === 'zh'
    ? {
        heroTitle: '个可安装的 DeepSeek Harness 插件',
        heroBody:
          '一条 npx dshpub 命令即可安装，每条记录都固定到公开 commit。搜索你需要的能力，或直接从下面的场景开始浏览。',
        highlightsEyebrow: '精选 / 社区高星',
        highlightsTitle: '社区里最多人用的插件',
        highlightsBody: '按源仓库的 GitHub Star 排序，均为可安装的社区插件。',
        wallEyebrow: '浏览 / 按使用场景',
        wallTitle: '按场景挑一个插件',
        wallBody: `${browseTotals.browsable.toLocaleString()} 条带有作者撰写说明的记录。另有 ${browseTotals.withoutDescription.toLocaleString()} 条自动发现但缺少说明的仓库，只在完整目录中可搜。`,
        all: '全部',
        more: '加载更多',
        loading: '加载中…',
        failed: '加载失败，改用完整目录浏览',
        results: '条结果',
        empty: '这个场景下暂时没有记录。',
        openRegistry: '打开完整目录',
        disclosure:
          '收录不代表兼容、安全或经过审计。安装前请查看源仓库、它请求的权限，以及它声明的运行时能力。',
        disclosureLink: '了解目录如何核对来源',
        agentIndex: '给 Agent 的 JSON 索引',
        desktopEyebrow: '官方桌面端',
        desktopTitle: 'DeepSeek Harness 桌面端现已开箱即用',
        desktopBody:
          '官方提供 macOS 与 Windows 安装包。在桌面端的「添加插件」里粘贴下面的 GitHub 地址并安装，重启后即可在设置里浏览全部插件。',
        desktopDownload: '下载官方桌面端',
        desktopInstallLabel: '添加插件时粘贴',
        desktopInstallNote: '安装完成后重启桌面端，打开设置里的「dsh.pub 插件目录」。',
        faqTitle: 'DeepSeek Harness 插件常见问题',
        faqBrowse: '浏览插件目录',
        faqSubmit: '提交插件',
      }
    : {
        heroTitle: 'installable DeepSeek Harness plugins',
        heroBody:
          'Install any of them with a single npx dshpub command, each pinned to a public commit. Search for a capability, or start from a use case below.',
        highlightsEyebrow: 'FEATURED / MOST STARRED',
        highlightsTitle: 'What the community actually installs',
        highlightsBody:
          'Installable community plugins, ranked by the GitHub stars of their source repository.',
        wallEyebrow: 'BROWSE / BY USE CASE',
        wallTitle: 'Pick a plugin by what it does',
        wallBody: `${browseTotals.browsable.toLocaleString()} records with a summary written by their author. A further ${browseTotals.withoutDescription.toLocaleString()} auto-discovered repositories ship no summary and stay searchable in the full catalog only.`,
        all: 'All',
        more: 'Load more',
        loading: 'Loading…',
        failed: 'Could not load the index — browse the full catalog instead',
        results: 'results',
        empty: 'No records in this use case yet.',
        openRegistry: 'Open the full catalog',
        disclosure:
          'Listing does not imply compatibility, safety, or an audit. Inspect the source repository, the authority it requests, and the runtime capabilities it declares before installing.',
        disclosureLink: 'How the registry verifies source',
        agentIndex: 'JSON index for agents',
        desktopEyebrow: 'OFFICIAL DESKTOP',
        desktopTitle: 'The DeepSeek Harness desktop app is ready to install',
        desktopBody:
          'Official macOS and Windows installers are available. In the desktop app, open Add plugin, paste the GitHub address below, and restart to browse every plugin from Settings.',
        desktopDownload: 'Download the official desktop app',
        desktopInstallLabel: 'Paste into Add plugin',
        desktopInstallNote: 'After a restart, open Settings and choose dsh.pub Registry.',
        faqTitle: 'DeepSeek Harness plugin FAQ',
        faqBrowse: 'Browse the registry',
        faqSubmit: 'Submit a plugin',
      };

const faqs = [
  { question: t.registryGuideWhatTitle, answer: t.registryGuideWhatBody },
  { question: t.registryGuideDifferenceTitle, answer: t.registryGuideDifferenceBody },
  {
    question: t.registryGuideInstallTitle,
    answer: t.registryGuideInstallBody,
    href: `/${locale}/plugins/`,
    action: ui.faqBrowse,
  },
  {
    question: t.registryGuideChooseTitle,
    answer: t.registryGuideChooseBody,
    href: `/${locale}/plugins/`,
    action: ui.faqBrowse,
  },
  {
    question: t.registryGuidePublishTitle,
    answer: t.registryGuidePublishBody,
    href: `/${locale}/submit/`,
    action: ui.faqSubmit,
  },
];

const officialDesktopUrl = 'https://www.deepseek.com/harness/';
const desktopInstall = 'github:dsh-pub/dsh-pub#main&path:/apps/dsh-plugin';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'dsh.pub',
    alternateName: ['DeepSeek Harness Plugin Registry', 'DSH Plugin Registry'],
    url: `https://dsh.pub/${locale}/`,
    description: t.siteDescription,
    inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
    potentialAction: {
      '@type': 'SearchAction',
      target: `https://dsh.pub/${locale}/plugins/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];
---

<BaseLayout
  locale={locale}
  showHeaderSearch={false}
  structuredData={structuredData}
  loadAdSense={Boolean(homeAdSlot)}
>
  <section class="registry-hero">
    <HarnessBackdrop />

    <div class="hero-inner page-shell">
      <p class="eyebrow">{t.registryHeading}</p>
      <h1><b>{installable}</b> {ui.heroTitle}</h1>
      <p class="hero-copy">{ui.heroBody}</p>

      <form class="hero-search" role="search" action={`/${locale}/plugins/`}>
        <Icon name="search" size={22} />
        <input type="search" name="q" aria-label={t.search} placeholder={t.search} />
        <button type="submit" aria-label={t.browse}><Icon name="arrow" size={19} /></button>
      </form>
    </div>
  </section>

  <section class="desktop-band" aria-labelledby="desktop-app-title">
    <div class="page-shell desktop-band-inner">
      <div>
        <span class="eyebrow">{ui.desktopEyebrow}</span>
        <h2 id="desktop-app-title">{ui.desktopTitle}</h2>
        <p>{ui.desktopBody}</p>
        <a class="desktop-download" href={officialDesktopUrl} rel="noreferrer">
          {ui.desktopDownload}
          <Icon name="arrow" size={16} />
        </a>
      </div>
      <div class="desktop-install">
        <p>{ui.desktopInstallLabel}</p>
        <code>{desktopInstall}</code>
        <p>{ui.desktopInstallNote}</p>
      </div>
    </div>
  </section>

  {
    highlights.length > 0 && (
      <section class="home-section page-shell">
        <div class="section-heading">
          <div>
            <span class="eyebrow">{ui.highlightsEyebrow}</span>
            <h2>{ui.highlightsTitle}</h2>
            <p>{ui.highlightsBody}</p>
          </div>
          <a class="text-link" href={`/${locale}/plugins/`}>
            {ui.openRegistry}
            <Icon name="arrow" size={16} />
          </a>
        </div>
        <div class="highlight-grid">
          {highlights.map((entry) => (
            <PluginTile tile={browseTile(entry, locale)} locale={locale} stars={starsFor(entry)} />
          ))}
        </div>
      </section>
    )
  }

  <section class="home-section wall-section">
    <div class="page-shell">
      <div class="section-heading">
        <div>
          <span class="eyebrow">{ui.wallEyebrow}</span>
          <h2>{ui.wallTitle}</h2>
          <p>{ui.wallBody}</p>
        </div>
      </div>

      <nav class="use-case-chips" aria-label={ui.wallTitle}>
        <button type="button" class="active" data-use-case-filter="">
          {ui.all}<small>{browseTotals.browsable.toLocaleString()}</small>
        </button>
        {
          browseUseCases.map(({ id, count }) => (
            <button type="button" data-use-case-filter={id}>
              {useCaseLabel(id, locale)}
              <small>{count.toLocaleString()}</small>
            </button>
          ))
        }
      </nav>

      <div
        class="plugin-wall"
        data-wall
        data-index-url={`/${locale}/browse.json`}
        data-locale={locale}
      >
        {
          initialTiles.map((entry) => (
            <PluginTile tile={browseTile(entry, locale)} locale={locale} />
          ))
        }
      </div>

      <p class="wall-empty" data-wall-empty hidden>{ui.empty}</p>

      <div class="wall-foot">
        <button
          type="button"
          data-wall-more
          data-label={ui.more}
          data-loading={ui.loading}
          data-results={ui.results}
          data-failed={ui.failed}
        >
          {ui.more}
        </button>
        <span data-wall-status aria-live="polite"></span>
        <a class="text-link" href={`/${locale}/plugins/`}>
          {ui.openRegistry}<Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </section>

  <p class="disclosure page-shell">
    <span>{ui.disclosure}</span>
    <a href="#faq-title">{ui.disclosureLink}</a>
    <a href="https://dsh.pub/plugins.json">{ui.agentIndex}</a>
  </p>

  <section class="faq-section" aria-labelledby="faq-title">
    <div class="faq-layout page-shell">
      <div class="faq-heading">
        <span class="eyebrow">FAQ</span>
        <h2 id="faq-title">{ui.faqTitle}</h2>
        <div class="faq-actions">
          <a class="text-link" href={`/${locale}/plugins/`}>
            {ui.faqBrowse}<Icon name="arrow" size={16} />
          </a>
          <a class="text-link" href={`/${locale}/submit/`}>
            {ui.faqSubmit}<Icon name="arrow" size={16} />
          </a>
        </div>
      </div>

      <div class="faq-list">
        {
          faqs.map((faq, index) => (
            <details>
              <summary>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{faq.question}</h3>
              </summary>
              <div class="faq-answer">
                <p>{faq.answer}</p>
                {faq.href && faq.action && (
                  <a class="text-link" href={faq.href}>
                    {faq.action}
                    <Icon name="arrow" size={15} />
                  </a>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {
    homeAdSlot && (
      <div class="page-shell home-ad">
        <AdSlot locale={locale} unit={homeAdSlot} class="home-ad-slot" />
      </div>
    )
  }
</BaseLayout>

<script>
  interface BrowseIndex {
    total: number;
    useCases: string[];
    useCaseLabels: string[];
    rows: Array<[string, string, string, number]>;
  }

  const wallElement = document.querySelector<HTMLElement>('[data-wall]');
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-use-case-filter]')];
  const moreButton = document.querySelector<HTMLButtonElement>('[data-wall-more]');
  const status = document.querySelector<HTMLElement>('[data-wall-status]');
  const empty = document.querySelector<HTMLElement>('[data-wall-empty]');

  if (wallElement && moreButton) {
    // Rebound so the closures below inherit the non-null narrowing.
    const wall = wallElement;
    const more = moreButton;

    const locale = wall.dataset.locale ?? 'en';
    const indexUrl = wall.dataset.indexUrl ?? '';
    const pageSize = wall.children.length || 60;
    const resultsLabel = more.dataset.results ?? '';

    let index: BrowseIndex | undefined;
    let filter = '';
    let rendered = pageSize;

    const escape = (value: string) =>
      value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    // Mirrors PluginTile.astro; both rely on the globally styled `.plugin-tile` class.
    function tileMarkup(row: [string, string, string, number], data: BrowseIndex): string {
      const [slug, name, description, useCase] = row;
      return `<a class="plugin-tile" href="/${locale}/plugins/${encodeURIComponent(slug)}/" data-use-case="${data.useCases[useCase]}"><strong>${escape(name)}</strong><span>${escape(description)}</span><em>${escape(data.useCaseLabels[useCase] ?? '')}</em></a>`;
    }

    async function loadIndex(): Promise<BrowseIndex | undefined> {
      if (index) return index;
      more.disabled = true;
      more.textContent = more.dataset.loading ?? 'Loading…';
      try {
        const response = await fetch(indexUrl);
        if (!response.ok) throw new Error(`browse index unavailable: ${response.status}`);
        index = (await response.json()) as BrowseIndex;
        return index;
      } catch {
        more.hidden = true;
        if (status) status.textContent = more.dataset.failed ?? '';
        return undefined;
      } finally {
        more.disabled = false;
        more.textContent = more.dataset.label ?? 'Load more';
      }
    }

    function matchingRows(data: BrowseIndex) {
      if (!filter) return data.rows;
      return data.rows.filter((row) => data.useCases[row[3]] === filter);
    }

    function paint(data: BrowseIndex) {
      const rows = matchingRows(data);
      const slice = rows.slice(0, rendered);
      wall.innerHTML = slice.map((row) => tileMarkup(row, data)).join('');
      more.hidden = slice.length >= rows.length;
      if (empty) empty.hidden = rows.length !== 0;
      if (status) {
        status.textContent = rows.length
          ? `${slice.length.toLocaleString()} / ${rows.length.toLocaleString()} ${resultsLabel}`
          : '';
      }
    }

    for (const chip of chips) {
      chip.addEventListener('click', async () => {
        const next = chip.dataset.useCaseFilter ?? '';
        if (next === filter) return;
        filter = next;
        rendered = pageSize;
        for (const other of chips) other.classList.toggle('active', other === chip);
        const data = await loadIndex();
        if (data) paint(data);
      });
    }

    more.addEventListener('click', async () => {
      const data = await loadIndex();
      if (!data) return;
      rendered += pageSize * 2;
      paint(data);
    });
  }
</script>

<style>
  .home-ad {
    margin-block: 1.5rem 2.5rem;
  }

  .home-ad :global(.home-ad-slot) {
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 10px;
    padding: 1rem;
  }

  .registry-hero {
    background: var(--color-navy-900);
    color: var(--color-text-on-dark);
    overflow: hidden;
    position: relative;
  }

  .hero-inner {
    padding-bottom: 3.1rem;
    padding-top: 3.1rem;
    position: relative;
  }

  .hero-inner :global(.eyebrow) {
    color: var(--color-blue-300);
  }

  h1 {
    font-size: clamp(2.1rem, 3.5vw, 3.35rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.04;
    margin: 0.6rem 0 0;
    max-width: 26ch;
  }

  h1 b {
    color: var(--color-blue-300);
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .hero-copy {
    color: #c4d0de;
    font-size: 1rem;
    line-height: 1.6;
    margin: 1rem 0 1.4rem;
    max-width: 46rem;
  }

  .hero-search {
    align-items: center;
    background: white;
    border: 2px solid #728399;
    border-radius: 9px;
    box-shadow: 0 18px 55px rgb(3 12 23 / 28%);
    color: #597087;
    display: flex;
    height: 58px;
    max-width: 620px;
    padding: 0 0.4rem 0 1rem;
  }

  .hero-search:focus-within {
    border-color: var(--color-blue-300);
    outline: 2px solid rgb(104 184 255 / 30%);
    outline-offset: 3px;
  }

  .hero-search input {
    background: transparent;
    border: 0;
    color: #172335;
    flex: 1;
    font-size: 1rem;
    min-width: 4rem;
    outline: 0;
    padding: 0 0.8rem;
  }

  .hero-search button {
    align-items: center;
    align-self: stretch;
    background: var(--color-blue-600);
    border: 0;
    border-radius: 6px;
    color: white;
    cursor: pointer;
    display: flex;
    justify-content: center;
    margin: 0;
    min-width: 54px;
  }

  .desktop-band {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-rule);
  }

  .desktop-band-inner {
    display: grid;
    gap: 1.5rem 2.5rem;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr);
    padding-bottom: 2.4rem;
    padding-top: 2.4rem;
  }

  .desktop-band h2 {
    font-size: clamp(1.45rem, 2vw, 1.9rem);
    font-weight: 520;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0.35rem 0 0;
    max-width: 22ch;
  }

  .desktop-band p {
    color: var(--color-text-muted);
    margin: 0.7rem 0 0;
    max-width: 40rem;
  }

  .desktop-download {
    align-items: center;
    background: var(--color-navy-900);
    border-radius: 8px;
    color: var(--color-text-on-dark);
    display: inline-flex;
    font-weight: 560;
    gap: 0.45rem;
    margin-top: 1.1rem;
    min-height: 42px;
    padding: 0.55rem 0.95rem;
    text-decoration: none;
  }

  .desktop-download:hover {
    background: var(--color-blue-600);
  }

  .desktop-install {
    align-self: center;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    padding: 1rem 1.05rem 1.1rem;
  }

  .desktop-install p:first-child {
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 640;
    letter-spacing: 0.06em;
    margin: 0;
  }

  .desktop-install code {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.55;
    margin-top: 0.7rem;
    overflow-wrap: anywhere;
  }

  .desktop-install p:last-child {
    font-size: 0.88rem;
    margin-top: 0.75rem;
  }

  .home-section {
    padding-bottom: 3.6rem;
    padding-top: 3.6rem;
  }

  .wall-section {
    background: color-mix(in srgb, var(--color-surface-subtle) 72%, var(--color-canvas));
    border-bottom: 1px solid var(--color-rule);
    border-top: 1px solid var(--color-rule);
  }

  .highlight-grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .use-case-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.15rem;
  }

  .use-case-chips button {
    align-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    color: var(--color-text);
    cursor: pointer;
    display: inline-flex;
    font-size: 0.82rem;
    gap: 0.4rem;
    min-height: 34px;
    padding: 0.25rem 0.8rem;
  }

  .use-case-chips button small {
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .use-case-chips button:hover {
    border-color: var(--color-accent);
  }

  .use-case-chips button.active {
    background: var(--color-accent-soft);
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-rule));
    color: var(--color-accent);
  }

  .use-case-chips button.active small {
    color: var(--color-accent);
  }

  .plugin-wall {
    display: grid;
    gap: 0.7rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .wall-empty {
    color: var(--color-text-muted);
    margin: 1.5rem 0 0;
  }

  .wall-foot {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.4rem;
    margin-top: 1.6rem;
  }

  .wall-foot button {
    background: var(--color-surface);
    border: 1px solid var(--color-rule-strong);
    border-radius: 8px;
    color: var(--color-text);
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 520;
    min-height: 40px;
    padding: 0.5rem 1.15rem;
  }

  .wall-foot button:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .wall-foot button[hidden] {
    display: none;
  }

  .wall-foot span {
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .disclosure {
    align-items: baseline;
    color: var(--color-text-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.83rem;
    gap: 0.3rem 0.9rem;
    line-height: 1.6;
    margin: 2.6rem auto 0;
    padding-bottom: 0.6rem;
  }

  .disclosure span {
    max-width: 68ch;
  }

  .faq-section {
    border-top: 1px solid var(--color-rule);
    margin-top: 2.6rem;
  }

  .faq-layout {
    display: grid;
    gap: clamp(2rem, 6vw, 5rem);
    grid-template-columns: minmax(220px, 0.6fr) minmax(0, 1.4fr);
    padding-bottom: 4rem;
    padding-top: 4rem;
  }

  .faq-heading h2 {
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin: 0.7rem 0 1rem;
  }

