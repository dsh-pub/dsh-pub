---
import Icon from '../../components/Icon.astro';
import Logo from '../../components/Logo.astro';
import PluginRow from '../../components/PluginRow.astro';
import {
  builtInEntries,
  bundleEntries,
  catalog,
  categoryCounts,
  communityEntries,
  featuredEntries,
} from '../../lib/catalog.js';
import { categoryLabel } from '../../lib/categories.js';
import { copy, isLocale, locales } from '../../lib/i18n.js';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang;
if (!isLocale(locale)) throw new Error(`Unsupported locale: ${locale}`);
const t = copy[locale];
const bundles = bundleEntries.slice(0, 3);
const featured = featuredEntries.length >= 6 ? featuredEntries : builtInEntries.slice(0, 8);
const categories = categoryCounts(builtInEntries).slice(0, 8);
const clientCount =
  catalog.totals.client ?? catalog.entries.filter((entry) => entry.runtime.client).length;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'dsh.pub',
  url: `https://dsh.pub/${locale}/`,
  description: t.siteDescription,
  inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
};
---

<BaseLayout locale={locale} showHeaderSearch={false} structuredData={structuredData}>
  <section class="registry-hero">
    <svg
      class="circuit-field"
      viewBox="0 0 1440 520"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
    >
      <g fill="none" stroke="currentColor" stroke-width="1">
        <path d="M-40 130h250l55 55h210l70-70h230l80 80h250l55-55h330"></path>
        <path d="M-10 350h180l85-85h155l100 100h275l65-65h190l115 115h320"></path>
        <path d="M320-20v120l60 60v205l-80 80v110M1050-20v155l-75 75v195l90 90v60"></path>
        <rect x="155" y="105" width="76" height="52"></rect>
        <rect x="600" y="82" width="94" height="64"></rect>
        <rect x="1170" y="112" width="88" height="58"></rect>
        <rect x="80" y="330" width="72" height="56"></rect>
        <rect x="690" y="333" width="92" height="62"></rect>
        <rect x="1265" y="382" width="82" height="54"></rect>
        <circle cx="265" cy="185" r="7"></circle><circle cx="545" cy="115" r="7"></circle>
        <circle cx="850" cy="300" r="7"></circle><circle cx="1155" cy="415" r="7"></circle>
      </g>
    </svg>
    <div class="hero-inner page-shell">
      <div class="hero-brand"><Logo /></div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.heroTitle.split('\n').map((line) => <span>{line}</span>)}</h1>
      <p class="hero-copy">{t.heroBody}</p>
      <form class="hero-search" role="search" action={`/${locale}/plugins/`}>
        <Icon name="search" size={23} />
        <input type="search" name="q" aria-label={t.search} placeholder={t.search} autofocus />
        <button type="submit"><span>{t.browse}</span><Icon name="arrow" /></button>
      </form>
      <div class="hero-proof" aria-label="Registry attributes">
        <span><i></i>{t.sourceBacked}</span>
        <span><i></i>{t.bilingual}</span>
        <span><i></i>{t.noAccount}</span>
      </div>
    </div>
  </section>

  <section class="registry-stats" aria-label="Catalog snapshot">
    <div class="page-shell stats-inner">
      <div><strong>{catalog.totals.packages}</strong><span>{t.countPackages}</span></div>
      <div><strong>{catalog.totals.plugins}</strong><span>{t.countPlugins}</span></div>
      <div><strong>{clientCount}</strong><span>{t.countClient}</span></div>
      <div><strong>{catalog.totals.bundles}</strong><span>{t.countBundles}</span></div>
      <div><strong>{communityEntries.length}</strong><span>{t.countCommunity}</span></div>
    </div>
  </section>

  {
    bundles.length > 0 && (
      <section class="home-section page-shell">
        <div class="section-heading">
          <div>
            <span class="eyebrow">01 / MARKETPLACE</span>
            <h2>{t.officialBundles}</h2>
            <p>{t.officialBundlesBody}</p>
          </div>
          <a class="text-link" href={`/${locale}/plugins/?type=bundle`}>
            {t.viewAll}
            <Icon name="arrow" size={16} />
          </a>
        </div>
        <div class="bundle-list">
          {bundles.map((entry) => (
            <PluginRow entry={entry} locale={locale} compact />
          ))}
        </div>
      </section>
    )
  }

  {
    communityEntries.length > 0 && (
      <section class="home-section page-shell">
        <div class="section-heading">
          <div>
            <span class="eyebrow">02 / COMMUNITY</span>
            <h2>{t.communityPlugins}</h2>
            <p>{t.communityPluginsBody}</p>
            <p class="community-policy">{t.communityReviewNotice}</p>
          </div>
          <a class="text-link" href={`/${locale}/plugins/?provenance=community-reviewed`}>
            {t.viewAll}
            <Icon name="arrow" size={16} />
          </a>
        </div>
        <div class="bundle-list">
          {communityEntries.map((entry) => (
            <PluginRow entry={entry} locale={locale} compact />
          ))}
        </div>
      </section>
    )
  }

  <section class="home-section capability-section">
    <div class="page-shell">
      <div class="section-heading">
        <div>
          <span class="eyebrow">03 / CAPABILITY MAP</span>
          <h2>{t.exploreCapabilities}</h2>
          <p>{t.exploreCapabilitiesBody}</p>
        </div>
      </div>
      <div class="category-grid">
        {
          categories.map(([category, count], index) => (
            <a href={`/${locale}/plugins/?category=${category}`}>
              <span class="category-coordinate">0{index + 1}</span>
              <span class="category-glyph" aria-hidden="true">
                <>
                  <i />
                  <i />
                  <i />
                </>
              </span>
              <strong>{categoryLabel(category, locale)}</strong>
              <small>
                {count} {t.plugins.toLocaleLowerCase()}
              </small>
              <Icon name="arrow" size={16} />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-section page-shell">
    <div class="section-heading">
      <div>
        <span class="eyebrow">04 / BUILT-IN ROSTER</span>
        <h2>{t.builtIn}</h2>
        <p>{t.builtInBody}</p>
      </div>
      <a class="text-link" href={`/${locale}/plugins/`}>
        {t.viewAll}<Icon name="arrow" size={16} />
      </a>
    </div>
    <div>
      {featured.map((entry) => <PluginRow entry={entry} locale={locale} compact />)}
    </div>
  </section>
</BaseLayout>

<script>
  for (const element of document.querySelectorAll<HTMLElement>('[data-install-count]')) {
    const slug = element.dataset.installCount;
    if (!slug) continue;
    fetch(`/api/plugins/${encodeURIComponent(slug)}/stats`)
      .then((response) =>
        response.ok ? response.json() : Promise.reject(new Error('stats unavailable')),
      )
      .then((data: { total?: number }) => {
        element.textContent = new Intl.NumberFormat().format(data.total ?? 0);
      })
      .catch(() => undefined);
  }
</script>

<style>
  .registry-hero {
    background: var(--color-navy-900);
    color: var(--color-text-on-dark);
    min-height: 500px;
    overflow: hidden;
    position: relative;
  }

  .circuit-field {
    color: #4a6b8d;
    height: 100%;
    inset: 0;
    opacity: 0.32;
    position: absolute;
    width: 100%;
  }

  .hero-inner {
    align-items: center;
    display: flex;
    flex-direction: column;
    padding-bottom: 4.2rem;
    padding-top: 3.3rem;
    position: relative;
    text-align: center;
  }

  .hero-brand {
    display: none;
  }

  .hero-inner :global(.eyebrow) {
    color: var(--color-blue-300);
    margin: 0;
  }

  h1 {
    font-size: clamp(2.35rem, 5vw, 4.2rem);
    font-weight: 430;
    letter-spacing: -0.055em;
    line-height: 1.02;
    margin: 1.1rem 0 0;
    max-width: 850px;
  }

  h1 span {
    display: block;
  }

  .hero-copy {
    color: #c4d0de;
    font-size: clamp(1rem, 1.6vw, 1.18rem);
    line-height: 1.55;
    margin: 1.2rem auto 2rem;
    max-width: 660px;
  }

  .hero-search {
    align-items: center;
    background: #fff;
    border: 4px solid rgb(255 255 255 / 14%);
    border-radius: 9px;
    box-shadow: 0 18px 55px rgb(3 12 23 / 35%);
    color: #597087;
    display: flex;
    height: 68px;
    max-width: 850px;
    outline: 1px solid #50657c;
    padding: 0 0.45rem 0 1.15rem;
    width: 100%;
  }

  .hero-search:focus-within {
    outline: 2px solid var(--color-blue-300);
    outline-offset: 3px;
  }

  .hero-search input {
    background: transparent;
    border: 0;
    color: #172335;
    flex: 1;
    font-size: 1.15rem;
    min-width: 5rem;
    outline: 0;
    padding: 0 0.9rem;
  }

  .hero-search input::placeholder {
    color: #718195;
  }

  .hero-search button {
    align-items: center;
    align-self: stretch;
    background: var(--color-blue-600);
    border: 0;
    border-radius: 5px;
    color: white;
    cursor: pointer;
    display: flex;
    gap: 0.55rem;
    margin: 0;
    padding: 0 1.2rem;
  }

  .hero-search button:hover {
    background: #086ab7;
  }

  .hero-proof {
    color: #aabacd;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.78rem;
    gap: 1.35rem;
    justify-content: center;
    margin-top: 1.35rem;
  }

  .hero-proof span {
    align-items: center;
    display: flex;
    gap: 0.42rem;
  }

  .hero-proof i {
    background: var(--color-blue-300);
    display: inline-block;
    height: 5px;
    transform: rotate(45deg);
    width: 5px;
  }

  .registry-stats {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-rule);
  }

  .stats-inner {
    align-items: stretch;
    display: grid;
    grid-template-columns: repeat(5, minmax(100px, 1fr));
    min-height: 92px;
  }

  .stats-inner > div {
    align-items: baseline;
    border-right: 1px solid var(--color-rule);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 1.25rem;
  }

  .stats-inner > div:first-child {
    border-left: 1px solid var(--color-rule);
  }

  .stats-inner strong {
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 500;
  }

  .stats-inner span {
    color: var(--color-text-muted);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .home-section {
    padding-bottom: 4.8rem;
    padding-top: 4.8rem;
  }

  .home-section + .home-section {
    padding-top: 1rem;
  }

  .community-policy {
    color: var(--color-text-faint);
    font-size: 0.76rem;
    margin: 0.8rem 0 0;
    max-width: 46rem;
  }

  .capability-section {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-rule);
    border-top: 1px solid var(--color-rule);
    padding-top: 4.5rem !important;
  }

  .category-grid {
    border-left: 1px solid var(--color-rule);
    border-top: 1px solid var(--color-rule);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .category-grid > a {
    border-bottom: 1px solid var(--color-rule);
    border-right: 1px solid var(--color-rule);
    color: var(--color-text);
    display: grid;
    grid-template-columns: 1fr auto;
    min-height: 170px;
    padding: 1rem 1.2rem 1.15rem;
    position: relative;
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .category-grid > a:hover {
    background: var(--color-accent-soft);
    color: var(--color-accent);
    text-decoration: none;
  }

  .category-coordinate {
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .category-glyph {
    display: flex;
    gap: 3px;
    justify-self: end;
  }

  .category-glyph i {
    border: 1px solid var(--color-rule-strong);
    height: 11px;
    transform: rotate(45deg);
    width: 11px;
  }

  .category-glyph i:nth-child(2) {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .category-grid strong {
    align-self: end;
    font-size: 1.03rem;
    font-weight: 520;
  }

  .category-grid small {
    align-self: end;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    grid-column: 1;
    margin-top: 0.25rem;
  }

  .category-grid :global(.icon) {
    align-self: end;
    grid-column: 2;
    grid-row: 2 / 4;
  }

  @media (max-width: 900px) {
    .stats-inner {
      grid-template-columns: repeat(3, 1fr);
    }

    .stats-inner > div:nth-child(4),
    .stats-inner > div:nth-child(5) {
      border-top: 1px solid var(--color-rule);
    }

    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .registry-hero {
      min-height: 470px;
    }

    .hero-inner {
      padding-top: 2.6rem;
    }

    .hero-search {
      height: 58px;
    }

    .hero-search button span {
      display: none;
    }

    .stats-inner {
      grid-template-columns: repeat(2, 1fr);
    }

    .stats-inner > div:nth-child(2),
    .stats-inner > div:nth-child(4) {
      border-right: 0;
    }

    .stats-inner > div:nth-child(3),
    .stats-inner > div:nth-child(4),
    .stats-inner > div:nth-child(5) {
      border-top: 1px solid var(--color-rule);
    }

    .category-grid {
      grid-template-columns: 1fr;
    }

    .home-section {
      padding-bottom: 3.3rem;
      padding-top: 3.3rem;
    }
  }
</style>
