---
import EcosystemCard from '../../components/EcosystemCard.astro';
import HarnessBackdrop from '../../components/HarnessBackdrop.astro';
import Icon from '../../components/Icon.astro';
import PluginRow from '../../components/PluginRow.astro';
import UseCaseIcon from '../../components/UseCaseIcon.astro';
import { communityEntries, marketplaceEntries } from '../../lib/catalog.js';
import {
  ecosystemCandidates,
  ecosystemCategories,
  recentlyActiveEcosystemEntries,
  trendingEcosystemEntries,
} from '../../lib/ecosystem.js';
import { copy, isLocale, locales } from '../../lib/i18n.js';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang;
if (!isLocale(locale)) throw new Error(`Unsupported locale: ${locale}`);
const t = copy[locale];
const popular = trendingEcosystemEntries.slice(0, 3);
const popularIds = new Set(popular.map((entry) => entry.id));
const recentlyActive = recentlyActiveEcosystemEntries
  .filter((entry) => !popularIds.has(entry.id))
  .slice(0, 3);
const registryHighlights = communityEntries.slice(0, 3);
const useCases = ecosystemCategories.slice(0, 8);
const ui =
  locale === 'zh'
    ? {
        snapshot: 'Registry 目录统计',
        live: '实时目录',
        records: 'Registry 总数',
        agentLabel: 'AGENT / PLUGIN SEARCH',
        agentTitle: '给 Agent 的检索指令',
        copyGuide: '复制指令',
        copiedGuide: '已复制',
        agentPrompt:
          '在 dsh.pub 检索符合用户需求的 DeepSeek Harness 插件：优先搜索 /zh/plugins/?q=<关键词>&scope=registry 并核对来源、commit 与安装方式，必要时用 scope=ecosystem 扩大候选，并明确“收录不等于兼容、安全或可安装”。',
        browseCases: '按使用场景探索',
        browseCasesBody: '从用户任务出发浏览公开 DSH 生态，再回到 Registry 核对来源与运行时事实。',
        candidates: '个公开候选',
        popular: '生态热门项目',
        popularBody: '按 GitHub Star 数量排序的公开生态项目。',
        active: '最近活跃',
        activeBody: '近期有公开更新信号的生态项目。安装前仍需检查 Manifest、Profile 和权限。',
        reviewedTitle: '已核对的社区插件',
        reviewedBody: '固定到公开 commit、具备可追溯 Bundle 契约的可安装记录。',
        viewRegistry: '查看可信 Registry',
        viewIndex: '查看完整生态索引',
        evidenceTitle: '同一个目录，两条证据路径',
        evidenceBody:
          '生态索引负责扩大视野；Registry 记录负责回答来源、版本、运行时和真实安装方式。两者永远不会共用一个模糊的 Verified 标签。',
        faqTitle: 'DeepSeek Harness 插件常见问题',
        faqBody: '关于发现、安装、核对与发布 DSH 插件的源码可信答案。',
        faqBrowse: '浏览插件目录',
        faqSubmit: '提交插件',
        indexed: '生态候选',
        indexedBody: `${ecosystemCandidates.length} 条尚未进入 Registry 的公开项目，只提供发现信号。`,
        registry: 'Registry 记录',
        registryBody: `${marketplaceEntries.length} 条结构化记录，包含 DSH 内置模块和社区 Bundle。`,
        installable: '可安装记录',
        installableBody: `${communityEntries.length} 条社区 Bundle 提供固定 commit 的安装命令。`,
      }
    : {
        snapshot: 'Registry catalog totals',
        live: 'Live catalog',
        records: 'Registry total',
        agentLabel: 'AGENT / PLUGIN SEARCH',
        agentTitle: 'Plugin search instructions',
        copyGuide: 'Copy instructions',
        copiedGuide: 'Copied',
        agentPrompt:
          'Find DeepSeek Harness plugins on dsh.pub: search /en/plugins/?q=<keywords>&scope=registry first and verify source, commit, and installation; use scope=ecosystem only to widen candidates, and state that indexing does not imply compatibility, safety, or installability.',
        browseCases: 'Browse by use case',
        browseCasesBody:
          'Start from the job you need done, then return to Registry evidence before installing.',
        candidates: 'public candidates',
        popular: 'Popular across the ecosystem',
        popularBody: 'Public ecosystem projects ranked by GitHub stars.',
        active: 'Recently active',
        activeBody:
          'Projects with recent public updates. Check manifests, profiles, and authority before installation.',
        reviewedTitle: 'Source-reviewed community plugins',
        reviewedBody:
          'Installable records pinned to public commits with a traceable bundle contract.',
        viewRegistry: 'Open trusted Registry',
        viewIndex: 'Browse the ecosystem index',
        evidenceTitle: 'One directory, two evidence paths',
        evidenceBody:
          'The ecosystem index expands discovery. Registry records explain source, version, runtime, and truthful installation. They never collapse into one vague Verified badge.',
        faqTitle: 'DeepSeek Harness plugin FAQ',
        faqBody:
          'Source-backed answers about discovering, installing, verifying, and publishing DSH plugins.',
        faqBrowse: 'Browse the registry',
        faqSubmit: 'Submit a plugin',
        indexed: 'Ecosystem candidates',
        indexedBody: `${ecosystemCandidates.length} public projects not yet in the Registry, shown for discovery only.`,
        registry: 'Registry records',
        registryBody: `${marketplaceEntries.length} structured records covering built-in DSH modules and community bundles.`,
        installable: 'Installable records',
        installableBody: `${communityEntries.length} community bundles expose commit-pinned install commands.`,
      };

const faqs = [
  { question: t.registryGuideWhatTitle, answer: t.registryGuideWhatBody },
  {
    question: t.registryGuideDifferenceTitle,
    answer: t.registryGuideDifferenceBody,
  },
  {
    question: t.registryGuideInstallTitle,
    answer: t.registryGuideInstallBody,
    href: `/${locale}/plugins/`,
    action: ui.faqBrowse,
  },
  {
    question: t.registryGuideChooseTitle,
    answer: t.registryGuideChooseBody,
    href: `/${locale}/plugins/`,
    action: ui.faqBrowse,
  },
  {
    question: t.registryGuidePublishTitle,
    answer: t.registryGuidePublishBody,
    href: `/${locale}/submit/`,
    action: ui.faqSubmit,
  },
];
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'dsh.pub',
    alternateName: ['DeepSeek Harness Plugin Registry', 'DSH Plugin Registry'],
    url: `https://dsh.pub/${locale}/`,
    description: t.siteDescription,
    inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
    potentialAction: {
      '@type': 'SearchAction',
      target: `https://dsh.pub/${locale}/plugins/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];
---

<BaseLayout locale={locale} showHeaderSearch={false} structuredData={structuredData}>
  <section class="registry-hero">
    <HarnessBackdrop />

    <div class="hero-grid page-shell">
      <div class="hero-primary">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>
          <span>{t.registryHeading}</span>
          {' '}
          <span>{t.heroTitle.split('\n').at(-1)}</span>
        </h1>
        <p class="hero-copy">{t.heroBody}</p>
        <form class="hero-search" role="search" action={`/${locale}/plugins/`}>
          <Icon name="search" size={22} />
          <input type="search" name="q" aria-label={t.search} placeholder={t.search} autofocus />
          <button type="submit" aria-label={t.browse}><Icon name="arrow" size={19} /></button>
        </form>
      </div>

      <aside class="trust-snapshot" aria-label={ui.snapshot}>
        <div class="snapshot-heading">
          <strong>{ui.snapshot}</strong>
          <span>{ui.live}</span>
        </div>
        <div class="snapshot-body">
          <div class="snapshot-counts">
            <span>{ui.records}</span>
            <strong>{marketplaceEntries.length}</strong>
          </div>
          <div class="agent-guide" data-agent-guide>
            <div class="agent-guide-heading">
              <div>
                <span>{ui.agentLabel}</span>
                <strong>{ui.agentTitle}</strong>
              </div>
              <button
                type="button"
                data-copy-agent-guide
                data-copy-label={ui.copyGuide}
                data-copied-label={ui.copiedGuide}
              >
                <Icon name="copy" size={15} />
                <span>{ui.copyGuide}</span>
              </button>
            </div>
            <pre><code data-agent-guide-content>{ui.agentPrompt}</code></pre>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="home-section page-shell">
    <div class="section-heading">
      <div>
        <span class="eyebrow">ECOSYSTEM / USE CASES</span>
        <h2>{ui.browseCases}</h2>
        <p>{ui.browseCasesBody}</p>
      </div>
      <a class="text-link" href={`/${locale}/plugins/?scope=ecosystem`}>
        {ui.viewIndex}<Icon name="arrow" size={16} />
      </a>
    </div>
    <div class="use-case-grid">
      {
        useCases.map(({ category, count }) => (
          <a href={`/${locale}/plugins/?scope=ecosystem&category=${encodeURIComponent(category)}`}>
            <span class="use-case-visual">
              <UseCaseIcon category={category} />
            </span>
            <strong>{category}</strong>
            <small>
              {count} {ui.candidates}
            </small>
            <Icon name="arrow" size={16} />
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-section signal-section">
    <div class="page-shell">
      <div class="section-heading">
        <div>
          <span class="eyebrow">PUBLIC SIGNALS / POPULARITY</span>
          <h2>{ui.popular}</h2>
          <p>{ui.popularBody}</p>
        </div>
        <a class="text-link" href={`/${locale}/plugins/?scope=ecosystem&sort=stars`}>
          {ui.viewIndex}<Icon name="arrow" size={16} />
        </a>
      </div>
      <div class="card-grid">
        {popular.map((entry) => <EcosystemCard entry={entry} locale={locale} featured />)}
      </div>
    </div>
  </section>

  {
    recentlyActive.length > 0 && (
      <section class="home-section page-shell">
        <div class="section-heading">
          <div>
            <span class="eyebrow">PUBLIC SIGNALS / FRESHNESS</span>
            <h2>{ui.active}</h2>
            <p>{ui.activeBody}</p>
          </div>
        </div>
        <div class="card-grid">
          {recentlyActive.map((entry) => (
            <EcosystemCard entry={entry} locale={locale} />
          ))}
        </div>
      </section>
    )
  }

  {
    registryHighlights.length > 0 && (
      <section class="home-section registry-section">
        <div class="page-shell">
          <div class="section-heading">
            <div>
              <span class="eyebrow">REGISTRY / SOURCE REVIEWED</span>
              <h2>{ui.reviewedTitle}</h2>
              <p>{ui.reviewedBody}</p>
            </div>
            <a
              class="text-link"
              href={`/${locale}/plugins/?scope=registry&provenance=community-reviewed`}
            >
              {ui.viewRegistry}
              <Icon name="arrow" size={16} />
            </a>
          </div>
          <div class="card-grid registry-card-grid">
            {registryHighlights.map((entry) => (
              <PluginRow entry={entry} locale={locale} compact />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="evidence-section page-shell" aria-labelledby="evidence-title">
    <div class="evidence-heading">
      <span class="eyebrow">DISCOVERY ≠ VERIFICATION</span>
      <h2 id="evidence-title">{ui.evidenceTitle}</h2>
      <p>{ui.evidenceBody}</p>
    </div>
    <div class="evidence-grid">
      <article><span>01</span><h3>{ui.indexed}</h3><p>{ui.indexedBody}</p></article>
      <article><span>02</span><h3>{ui.registry}</h3><p>{ui.registryBody}</p></article>
      <article><span>03</span><h3>{ui.installable}</h3><p>{ui.installableBody}</p></article>
    </div>
  </section>

  <section class="faq-section" aria-labelledby="faq-title">
    <div class="faq-layout page-shell">
      <div class="faq-heading">
        <span class="eyebrow">FAQ / SOURCE-BACKED ANSWERS</span>
        <h2 id="faq-title">{ui.faqTitle}</h2>
        <p>{ui.faqBody}</p>
        <div class="faq-actions">
          <a class="text-link" href={`/${locale}/plugins/`}>
            {ui.faqBrowse}<Icon name="arrow" size={16} />
          </a>
          <a class="text-link" href={`/${locale}/submit/`}>
            {ui.faqSubmit}<Icon name="arrow" size={16} />
          </a>
        </div>
      </div>

      <div class="faq-list">
        {
          faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{faq.question}</h3>
              </summary>
              <div class="faq-answer">
                <p>{faq.answer}</p>
                {faq.href && faq.action && (
                  <a class="text-link" href={faq.href}>
                    {faq.action}
                    <Icon name="arrow" size={15} />
                  </a>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  for (const element of document.querySelectorAll<HTMLElement>('[data-install-count]')) {
    const slug = element.dataset.installCount;
    if (!slug) continue;
    fetch(`/api/plugins/${encodeURIComponent(slug)}/stats`)
      .then((response) =>
        response.ok ? response.json() : Promise.reject(new Error('stats unavailable')),
      )
      .then((data: { total?: number }) => {
        element.textContent = new Intl.NumberFormat().format(data.total ?? 0);
      })
      .catch(() => undefined);
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-agent-guide]')) {
    if (button.dataset.bound === 'true') continue;
    button.dataset.bound = 'true';
    button.addEventListener('click', async () => {
      const guide = button
        .closest<HTMLElement>('[data-agent-guide]')
        ?.querySelector<HTMLElement>('[data-agent-guide-content]')?.textContent;
      if (!guide) return;
      await navigator.clipboard.writeText(guide);
      const label = button.querySelector('span');
      if (label) label.textContent = button.dataset.copiedLabel ?? 'Copied';
      button.classList.add('copied');
      window.setTimeout(() => {
        if (label) label.textContent = button.dataset.copyLabel ?? 'Copy';
        button.classList.remove('copied');
      }, 1600);
    });
  }
</script>

<style>
  .registry-hero {
    background: #0b1727;
    color: var(--color-text-on-dark);
    isolation: isolate;
    min-height: 590px;
    overflow: hidden;
    position: relative;
  }

  .hero-grid {
    align-items: center;
    display: grid;
    gap: clamp(3rem, 7vw, 6.5rem);
    grid-template-columns: minmax(0, 0.92fr) minmax(480px, 1.08fr);
    min-height: 590px;
    padding-bottom: 3.7rem;
    padding-top: 3.7rem;
    position: relative;
    z-index: 1;
  }

  .hero-primary :global(.eyebrow) {
    color: var(--color-blue-300);
  }

  h1 {
    font-size: clamp(2.9rem, 4.25vw, 4.2rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.98;
    margin: 0.75rem 0 0;
  }

  h1 span {
    display: block;
  }

  h1 span:last-child {
    color: var(--color-blue-300);
  }

  .hero-copy {
    color: #c4d0de;
    font-size: 1.03rem;
    line-height: 1.58;
    margin: 1.2rem 0 1.5rem;
    max-width: 34rem;
  }

  .hero-search {
    align-items: center;
    background: white;
    border: 2px solid #728399;
    border-radius: 9px;
    box-shadow: 0 18px 55px rgb(3 12 23 / 28%);
    color: #597087;
    display: flex;
    height: 62px;
    max-width: 580px;
    padding: 0 0.4rem 0 1rem;
  }

  .hero-search:focus-within {
    border-color: var(--color-blue-300);
    outline: 2px solid rgb(104 184 255 / 30%);
    outline-offset: 3px;
  }

  .hero-search input {
    background: transparent;
    border: 0;
    color: #172335;
    flex: 1;
    font-size: 1rem;
    min-width: 4rem;
    outline: 0;
    padding: 0 0.8rem;
  }

  .hero-search button {
    align-items: center;
    align-self: stretch;
    background: var(--color-blue-600);
    border: 0;
    border-radius: 6px;
    color: white;
    cursor: pointer;
    display: flex;
    justify-content: center;
    margin: 0;
    min-width: 54px;
  }

  .trust-snapshot {
    backdrop-filter: blur(18px);
    background: rgb(29 48 73 / 88%);
    border: 1px solid #3b526d;
    border-radius: 14px;
    box-shadow: 0 26px 70px rgb(4 12 23 / 28%);
    overflow: hidden;
  }

  .snapshot-heading {
    align-items: center;
    border-bottom: 1px solid #3b526d;
    display: flex;
    justify-content: space-between;
    min-height: 58px;
    padding: 0 1.35rem;
  }

  .snapshot-heading strong {
    font-size: 0.9rem;
    font-weight: 570;
  }

  .snapshot-heading span {
    background: #193b58;
    border: 1px solid #35607f;
    border-radius: 999px;
    color: #a9d4ff;
    font-size: 0.7rem;
    padding: 0.28rem 0.65rem;
  }

  .snapshot-counts {
    border-right: 1px solid #3b526d;
    padding: 1.5rem;
  }

  .snapshot-body {
    display: grid;
    grid-template-columns: minmax(190px, 0.78fr) minmax(0, 1.42fr);
  }

  .snapshot-counts > span {
    color: #91a4b9;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .snapshot-counts > strong {
    display: block;
    font-family: var(--font-mono);
    font-size: 2.8rem;
    font-weight: 500;
    margin: 0.45rem 0 0;
  }

  .agent-guide {
    min-width: 0;
    padding: 1.5rem;
  }

  .agent-guide-heading {
    align-items: flex-start;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .agent-guide-heading > div {
    display: grid;
    gap: 0.28rem;
  }

  .agent-guide-heading > div > span {
    color: var(--color-blue-300);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.09em;
  }

  .agent-guide-heading strong {
    font-size: 0.9rem;
    font-weight: 570;
  }

  .agent-guide-heading button {
    align-items: center;
    background: transparent;
    border: 1px solid #45627f;
    border-radius: 6px;
    color: #b9d8f6;
    cursor: pointer;
    display: inline-flex;
    flex: none;
    font-size: 0.67rem;
    gap: 0.35rem;
    min-height: 30px;
    padding: 0.35rem 0.55rem;
  }

  .agent-guide-heading button:hover,
  .agent-guide-heading button:focus-visible,
  .agent-guide-heading button.copied {
    background: #193b58;
    border-color: #68b8ff;
    color: white;
  }

  .agent-guide pre {
    background: #0e253b;
    border-left: 2px solid var(--color-blue-300);
    color: #c4d2e0;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    line-height: 1.58;
    margin: 0;
    overflow-x: auto;
    padding: 0.85rem 0.9rem;
    scrollbar-color: #45627f transparent;
    white-space: nowrap;
  }

  .agent-guide code {
    font: inherit;
  }

  .home-section {
    padding-bottom: 5.2rem;
    padding-top: 5.2rem;
  }

  .signal-section,
  .registry-section {
    background: color-mix(in srgb, var(--color-surface-subtle) 72%, var(--color-canvas));
    border-bottom: 1px solid var(--color-rule);
    border-top: 1px solid var(--color-rule);
  }

  .use-case-grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .use-case-grid a {
    align-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 10px;
    color: var(--color-text);
    display: grid;
    gap: 0.22rem 0.8rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
    min-height: 88px;
    padding: 1rem;
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .use-case-grid a:hover {
    border-color: var(--color-accent);
    text-decoration: none;
    transform: translateY(-2px);
  }

  .use-case-visual {
    align-items: center;
    background: var(--color-accent-soft);
    border: 1px solid color-mix(in srgb, var(--color-accent) 24%, var(--color-rule));
    border-radius: 7px;
    color: var(--color-accent);
    display: inline-flex;
    grid-row: 1 / 3;
    height: 38px;
    justify-content: center;
    width: 38px;
  }

  .use-case-visual :global(.use-case-symbol) {
    height: 22px;
    width: 22px;
  }

  .use-case-grid strong {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .use-case-grid small {
    color: var(--color-text-faint);
    font-size: 0.72rem;
  }

  .use-case-grid :global(.icon) {
    color: var(--color-text-faint);
    grid-row: 1 / 3;
  }

  .card-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .evidence-section {
    display: grid;
    gap: 3.5rem;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    padding-bottom: 1rem;
    padding-top: 5.5rem;
  }

  .evidence-heading h2 {
    font-size: clamp(2rem, 3.8vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
    margin: 0.9rem 0 1.2rem;
  }

  .evidence-heading p,
  .evidence-grid p {
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .evidence-grid {
    border-top: 1px solid var(--color-rule-strong);
  }

  .evidence-grid article {
    border-bottom: 1px solid var(--color-rule);
    display: grid;
    gap: 0.9rem;
    grid-template-columns: 2.5rem minmax(130px, 0.65fr) minmax(0, 1fr);
    padding: 1.35rem 0;
  }

  .evidence-grid article > span {
    color: var(--color-accent);
