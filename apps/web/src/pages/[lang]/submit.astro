---
import Icon from '../../components/Icon.astro';
import { isLocale, locales } from '../../lib/i18n.js';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang;
if (!isLocale(locale)) throw new Error(`Unsupported locale: ${locale}`);
const pageCopy = {
  en: {
    eyebrow: 'DSH / COMMUNITY / SUBMIT',
    title: 'Submit a DSH plugin',
    intro:
      'Paste one public GitHub repository. dsh.pub reads its root package metadata, validates the bundle contract, and lists valid plugins automatically.',
    proof: ['One repository URL', 'No registry account', 'No manual review queue'],
    analyzer: 'Repository submission',
    formTitle: 'GitHub repository URL',
    repositoryHint: 'The installable DSH bundle must live at the repository root.',
    submit: 'Submit repository',
    handoff:
      'You will finish by publishing a pre-filled GitHub Issue. The Issue is the public automation queue.',
    ready: 'Repository ready',
    invalidRepository: 'Enter a public GitHub repository such as owner/repository.',
    processTitle: 'Everything else is automatic',
    processBody: 'The repository remains the source of truth. dsh.pub never runs submitted code.',
    steps: [
      ['01', 'Pin the source', 'Resolve the default branch to an exact public commit.'],
      [
        '02',
        'Validate the bundle',
        'Check package metadata, patch, runtime entry, README, and license.',
      ],
      ['03', 'List and deploy', 'Run registry quality gates and publish the new catalog entry.'],
    ],
    badgeTitle: 'README badge, ready now',
    badgeBody:
      'It shows “not listed” before integration and changes to “listed” after the catalog reaches production.',
    markdown: 'Markdown',
    html: 'HTML',
    copy: 'Copy',
    copyMarkdown: 'Copy Markdown badge',
    copyHtml: 'Copy HTML badge',
    copied: 'Copied',
    badgeAlt: 'dsh.pub registry status: listed or not listed',
  },
  zh: {
    eyebrow: 'DSH / COMMUNITY / SUBMIT',
    title: '提交一个 DSH 插件',
    intro:
      '粘贴一个公开的 GitHub 仓库。dsh.pub 会读取仓库根目录的包元数据、校验组合包契约，并自动收录有效插件。',
    proof: ['只填一个仓库地址', '无需注册目录账号', '无需人工审核排队'],
    analyzer: '提交仓库',
    formTitle: 'GitHub 仓库地址',
    repositoryHint: '可安装的 DSH 组合包需要位于仓库根目录。',
    submit: '提交仓库',
    handoff: '下一步只需发布一个已预填的 GitHub Issue；这个 Issue 就是公开的自动化队列。',
    ready: '仓库地址已就绪',
    invalidRepository: '请输入公开的 GitHub 仓库，例如 owner/repository。',
    processTitle: '其他事情都由系统完成',
    processBody: '仓库始终是唯一事实来源；dsh.pub 不会执行提交的代码。',
    steps: [
      ['01', '固定源码', '把默认分支解析为一个精确的公开 commit。'],
      ['02', '校验组合包', '检查包元数据、patch、运行入口、README 与许可证。'],
      ['03', '收录并发布', '运行目录质量门禁，并发布新的插件条目。'],
    ],
    badgeTitle: 'README Badge 已经准备好',
    badgeBody: '集成前显示“not listed”，目录上线后会自动变成“listed”。',
    markdown: 'Markdown',
    html: 'HTML',
    copy: '复制',
    copyMarkdown: '复制 Markdown Badge',
    copyHtml: '复制 HTML Badge',
    copied: '已复制',
    badgeAlt: 'dsh.pub 目录状态：listed 或 not listed',
  },
} as const;
const t = pageCopy[locale];
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: t.title,
  url: `https://dsh.pub/${locale}/submit/`,
  description: t.intro,
  inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
  isPartOf: { '@type': 'WebSite', name: 'dsh.pub', url: `https://dsh.pub/${locale}/` },
};
const clientCopy = {
  invalidRepository: t.invalidRepository,
  ready: t.ready,
  badgeAlt: t.badgeAlt,
  copied: t.copied,
};
---

<BaseLayout
  locale={locale}
  title={t.title}
  description={t.intro}
  showHeaderSearch={false}
  structuredData={structuredData}
>
  <section class="submit-hero">
    <div
      class="page-shell submit-hero-grid"
      data-submission
      data-client-copy={JSON.stringify(clientCopy)}
    >
      <div class="submit-message">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.title}</h1>
        <p class="submit-intro">{t.intro}</p>
        <ul
          class="submission-proof"
          aria-label={locale === 'zh' ? '提交特点' : 'Submission benefits'}
        >
          {
            t.proof.map((item) => (
              <li>
                <span aria-hidden="true">✓</span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <section class="repository-card" aria-labelledby="repository-card-title">
        <div class="repository-card-heading">
          <span class="coordinate">01 / {t.analyzer}</span>
          <span class="card-status" aria-hidden="true"><i></i><i></i><i></i></span>
        </div>
        <h2 id="repository-card-title">{t.formTitle}</h2>
        <p>{t.repositoryHint}</p>
        <form data-submission-form novalidate>
          <label class="repository-field" data-field="repository">
            <span class="sr-only">{t.formTitle}</span>
            <span class="repository-input">
              <Icon name="github" size={22} />
              <input
                type="url"
                name="repository"
                autocomplete="url"
                aria-describedby="repository-error"
                placeholder="https://github.com/owner/repository"
                spellcheck="false"
                required
              />
            </span>
            <em id="repository-error" data-error></em>
          </label>
          <a
            class="submit-button"
            aria-disabled="true"
            data-submit-link
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>{t.submit}</span>
            <Icon name="arrow" size={16} />
          </a>
          <span class="ready-status" data-ready-status aria-live="polite"></span>
        </form>
        <p class="handoff-note">{t.handoff}</p>
      </section>
    </div>
  </section>

  <section class="submission-details page-shell">
    <div class="process-panel" aria-labelledby="process-title">
      <span class="coordinate">02 / AUTOMATION</span>
      <h2 id="process-title">{t.processTitle}</h2>
      <p>{t.processBody}</p>
      <ol>
        {
          t.steps.map(([number, title, body]) => (
            <li>
              <span>{number}</span>
              <div>
                <>
                  <strong>{title}</strong>
                  <p>{body}</p>
                </>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <section class="badge-panel" aria-labelledby="badge-title" data-badge-panel hidden>
      <div class="badge-copy">
        <span class="coordinate">03 / README BADGE</span>
        <h2 id="badge-title">{t.badgeTitle}</h2>
        <p>{t.badgeBody}</p>
        <img alt={t.badgeAlt} data-badge-image />
      </div>
      <div class="badge-snippets">
        <div class="snippet" data-snippet="markdown">
          <span>{t.markdown}</span>
          <div>
            <code data-snippet-value></code><button type="button" aria-label={t.copyMarkdown}
              >{t.copy}</button
            >
          </div>
        </div>
        <div class="snippet" data-snippet="html">
          <span>{t.html}</span>
          <div>
            <code data-snippet-value></code><button type="button" aria-label={t.copyHtml}
              >{t.copy}</button
            >
          </div>
        </div>
        <p class="copy-status" data-copy-status aria-live="polite"></p>
      </div>
    </section>
  </section>
</BaseLayout>

<script>
  import { buildSubmissionArtifacts } from '../../lib/submission.js';

  const root = document.querySelector<HTMLElement>('[data-submission]');
  const form = root?.querySelector<HTMLFormElement>('[data-submission-form]');
  const clientCopy = JSON.parse(root?.dataset.clientCopy ?? '{}') as Record<string, string>;
  const repository = form?.elements.namedItem('repository') as HTMLInputElement | null;
  const submitLink = root?.querySelector<HTMLAnchorElement>('[data-submit-link]');
  const readyStatus = root?.querySelector<HTMLElement>('[data-ready-status]');
  const badgePanel = document.querySelector<HTMLElement>('[data-badge-panel]');
  const badgeImage = badgePanel?.querySelector<HTMLImageElement>('[data-badge-image]');
  const copyStatus = badgePanel?.querySelector<HTMLElement>('[data-copy-status]');
  let touched = false;

  function render() {
    if (!repository || !submitLink) return;
    let artifacts;
    try {
      artifacts = buildSubmissionArtifacts({ repository: repository.value });
      repository.setAttribute('aria-invalid', 'false');
    } catch {
      repository.setAttribute('aria-invalid', touched ? 'true' : 'false');
    }

    const error = root?.querySelector<HTMLElement>('[data-error]');
    if (error) error.textContent = touched && !artifacts ? clientCopy.invalidRepository : '';
    if (!artifacts) {
      submitLink.removeAttribute('href');
      submitLink.setAttribute('aria-disabled', 'true');
      if (readyStatus) readyStatus.textContent = '';
      if (badgePanel) badgePanel.hidden = true;
      return;
    }

    submitLink.href = artifacts.issueUrl;
    submitLink.setAttribute('aria-disabled', 'false');
    if (readyStatus) readyStatus.textContent = clientCopy.ready;
    if (badgePanel) badgePanel.hidden = false;
    if (badgeImage) {
      badgeImage.src = artifacts.badgeUrl;
      badgeImage.alt = clientCopy.badgeAlt;
    }
    for (const snippet of badgePanel?.querySelectorAll<HTMLElement>('[data-snippet]') ?? []) {
      const kind = snippet.dataset.snippet;
      const value = snippet.querySelector<HTMLElement>('[data-snippet-value]');
      if (value) value.textContent = kind === 'markdown' ? artifacts.markdown : artifacts.html;
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    touched = true;
    render();
    if (submitLink?.href && submitLink.getAttribute('aria-disabled') === 'false') {
      submitLink.click();
      return;
    }
    repository?.focus();
  });
  repository?.addEventListener('blur', () => {
    touched = true;
    render();
  });
  repository?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      form?.requestSubmit();
    }
  });
  repository?.addEventListener('input', render);
  for (const snippet of badgePanel?.querySelectorAll<HTMLElement>('[data-snippet]') ?? []) {
    snippet.querySelector('button')?.addEventListener('click', async () => {
      const value = snippet.querySelector('[data-snippet-value]')?.textContent ?? '';
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        if (copyStatus) copyStatus.textContent = clientCopy.copied;
      } catch {
        if (copyStatus) copyStatus.textContent = '';
      }
    });
  }
  render();
</script>

<style>
  .submit-hero {
    background: var(--color-navy-900);
    color: var(--color-text-on-dark);
    overflow: hidden;
    position: relative;
  }

  .submit-hero::before {
    background-image:
      linear-gradient(rgb(104 184 255 / 10%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(104 184 255 / 10%) 1px, transparent 1px);
    background-size: 52px 52px;
    content: '';
    inset: 0;
    mask-image: linear-gradient(90deg, black, rgb(0 0 0 / 12%));
    pointer-events: none;
    position: absolute;
  }

  .submit-hero-grid {
    align-items: center;
    display: grid;
    gap: clamp(3rem, 7vw, 7rem);
    grid-template-columns: minmax(0, 1fr) minmax(410px, 0.82fr);
    min-height: 650px;
    padding-bottom: 5rem;
    padding-top: 5rem;
    position: relative;
  }

  .submit-message h1 {
    font-size: clamp(3rem, 6vw, 5.5rem);
    letter-spacing: -0.065em;
    line-height: 0.94;
    margin: 1.1rem 0 1.5rem;
    max-width: 690px;
  }

  .submit-intro {
    color: #c4d1df;
    font-size: clamp(1rem, 1.7vw, 1.16rem);
    line-height: 1.7;
    margin: 0;
    max-width: 690px;
  }

  .submission-proof {
    display: grid;
    gap: 0.8rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .submission-proof li {
    align-items: center;
    color: #e3edf7;
    display: flex;
    font-size: 0.9rem;
    gap: 0.7rem;
  }

  .submission-proof li span {
    align-items: center;
    border: 1px solid var(--color-blue-300);
    border-radius: 50%;
    color: var(--color-blue-300);
    display: inline-flex;
    font-family: var(--font-mono);
    height: 20px;
    justify-content: center;
    width: 20px;
  }

  .repository-card {
    background: var(--color-surface);
    border: 1px solid #5d7189;
    border-radius: 12px;
    box-shadow: 16px 16px 0 #07101b;
    color: var(--color-text);
    padding: clamp(1.5rem, 3vw, 2.3rem);
  }

  .repository-card-heading {
    align-items: center;
    border-bottom: 1px solid var(--color-rule);
    display: flex;
    justify-content: space-between;
    padding-bottom: 1rem;
  }

  .coordinate {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-status {
    display: flex;
    gap: 5px;
  }

  .card-status i {
    background: var(--color-rule-strong);
    border-radius: 50%;
    height: 6px;
    width: 6px;
  }

  .repository-card h2,
  .process-panel h2,
  .badge-panel h2 {
    font-size: 1.6rem;
    letter-spacing: -0.035em;
    margin: 1.55rem 0 0.5rem;
  }

  .repository-card > p,
  .process-panel > p,
  .badge-copy > p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  form {
    margin-top: 1.7rem;
  }

  .repository-input {
    align-items: center;
    background: white;
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-small);
    display: flex;
    gap: 0.75rem;
    min-height: 58px;
    padding: 0 1rem;
  }

  .repository-input:focus-within {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgb(0 123 214 / 13%);
  }

  .repository-input:has(input[aria-invalid='true']) {
    border-color: #b42318;
  }

  .repository-input input {
    background: transparent;
    border: 0;
    color: var(--color-text);
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    min-width: 0;
    outline: 0;
  }

  .repository-field em {
    color: #b42318;
    display: block;
    font-size: 0.75rem;
    font-style: normal;
    min-height: 1.1rem;
    padding-top: 0.4rem;
  }

  .submit-button {
    align-items: center;
    background: var(--color-blue-600);
    color: white;
    display: flex;
    font-weight: 650;
    gap: 0.7rem;
    justify-content: center;
    min-height: 54px;
    padding: 0 1.2rem;
    width: 100%;
  }

  .submit-button:hover {
    background: #0667b4;
    text-decoration: none;
  }

  .submit-button[aria-disabled='true'] {
    background: var(--color-rule-strong);
    color: var(--color-text-muted);
    cursor: not-allowed;
    pointer-events: none;
  }

  .ready-status {
    color: #25804f;
    display: block;
    font-size: 0.76rem;
    min-height: 1.1rem;
    padding-top: 0.45rem;
    text-align: center;
  }

  .repository-card .handoff-note {
    border-top: 1px solid var(--color-rule);
    color: var(--color-text-faint);
    font-size: 0.76rem;
    margin-top: 0.65rem;
    padding-top: 1rem;
    text-align: center;
  }

  .submission-details {
    padding-bottom: 5rem;
    padding-top: 4.5rem;
  }

  .process-panel {
    border-top: 3px solid var(--color-text);
    padding-top: 1rem;
  }

  .process-panel ol {
    display: grid;
    gap: 0;
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .process-panel li {
    border-left: 1px solid var(--color-rule);
    display: grid;
    gap: 1rem;
    grid-template-columns: 32px 1fr;
    min-height: 130px;
    padding: 0.2rem 1.5rem;
  }

  .process-panel li:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .process-panel li > span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .process-panel li strong {
    font-size: 0.95rem;
  }

  .process-panel li p {
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.55;
    margin: 0.4rem 0 0;
  }

  .badge-panel {
    background: var(--color-navy-900);
    color: var(--color-text-on-dark);
    display: grid;
    gap: 3rem;
    grid-template-columns: minmax(260px, 0.7fr) minmax(0, 1.3fr);
    margin-top: 4rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .badge-panel[hidden] {
    display: none;
  }

  .badge-copy > p {
    color: #aebed0;
  }

  .badge-copy img {
    height: 20px;
    margin-top: 1.5rem;
  }

  .snippet + .snippet {
    margin-top: 1rem;
  }

  .snippet > span {
    color: #8fa3b8;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .snippet > div {
    border: 1px solid #2c435e;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    margin-top: 0.35rem;
    min-height: 48px;
  }

  .snippet code {
    align-self: center;
    color: #d8e6f4;
    font-size: 0.69rem;
    overflow-x: auto;
    padding: 0.75rem;
    white-space: nowrap;
  }

  .snippet button {
    background: #1d3049;
    border: 0;
    border-left: 1px solid #2c435e;
    color: #d8e6f4;
    cursor: pointer;
    min-width: 66px;
  }

  .copy-status {
    color: var(--color-blue-300);
    font-size: 0.75rem;
    min-height: 1.1rem;
  }

  .sr-only {
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    width: 1px;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .submit-hero-grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .repository-card {
      box-shadow: 10px 10px 0 #07101b;
      max-width: 620px;
    }

    .process-panel ol,
    .badge-panel {
      grid-template-columns: 1fr;
    }

    .process-panel li {
      border-left: 0;
      border-top: 1px solid var(--color-rule);
      min-height: 0;
      padding: 1rem 0;
    }
  }

  @media (max-width: 560px) {
    .submit-hero-grid {
      padding-bottom: 4rem;
      padding-top: 3.5rem;
    }

    .repository-card {
      border-radius: 8px;
      box-shadow: 7px 7px 0 #07101b;
    }

    .repository-input {
      padding: 0 0.75rem;
    }

    .submission-details {
      padding-top: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .submit-button {
      transition: none;
    }
  }
</style>
