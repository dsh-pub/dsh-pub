---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { copy, otherLocale, type Locale } from '../lib/i18n.js';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  showHeaderSearch?: boolean;
  noIndex?: boolean;
}

const {
  locale,
  title,
  description = copy[locale].siteDescription,
  structuredData = [],
  showHeaderSearch = true,
  noIndex = false,
} = Astro.props;
const pageTitle = title
  ? `${title} · dsh.pub`
  : locale === 'zh'
    ? 'dsh.pub — DeepSeek Harness 插件目录'
    : 'dsh.pub — DeepSeek Harness plugin registry';
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternatePath = Astro.url.pathname.replace(`/${locale}`, `/${otherLocale(locale)}`);
const alternateLocale = otherLocale(locale);
const localeCodes = { en: 'en', zh: 'zh-CN' } as const;
const openGraphLocales = { en: 'en_US', zh: 'zh_CN' } as const;
const socialImage = new URL('/og/dsh-pub.png', Astro.site);
const socialImageAlt =
  locale === 'zh'
    ? 'dsh.pub：DeepSeek Harness 插件目录与系统地图'
    : 'dsh.pub: the DeepSeek Harness plugin directory and system map';
const structuredDataItems = Array.isArray(structuredData) ? structuredData : [structuredData];
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();
const analyticsEnabled = Boolean(gaMeasurementId && /^G-[A-Z0-9]+$/.test(gaMeasurementId));
const analyticsConfig = analyticsEnabled
  ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',${JSON.stringify(gaMeasurementId)});`
  : '';
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14243a" />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/brand/dshbot-favicon.png" type="image/png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={localeCodes[locale]} href={canonical} />
    <link
      rel="alternate"
      hreflang={localeCodes[alternateLocale]}
      href={new URL(alternatePath, Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(`/en${Astro.url.pathname.replace(/^\/(en|zh)/, '')}`, Astro.site)}
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="dsh.pub" />
    <meta property="og:locale" content={openGraphLocales[locale]} />
    <meta property="og:locale:alternate" content={openGraphLocales[alternateLocale]} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <title>{pageTitle}</title>
    {
      structuredDataItems.map((item) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(item).replaceAll('<', '\\u003c')}
        />
      ))
    }
    {
      analyticsEnabled && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}
          />
          <script is:inline set:html={analyticsConfig} />
        </>
      )
    }
    <script is:inline>
      (() => {
        const value = localStorage.getItem('dsh-theme');
        if (value === 'light' || value === 'dark') document.documentElement.dataset.theme = value;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header locale={locale} path={Astro.url.pathname} showSearch={showHeaderSearch} />
    <main id="main-content"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
