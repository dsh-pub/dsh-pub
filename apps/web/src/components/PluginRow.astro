---
import {
  displayName,
  installMetricSlug,
  localized,
  provenanceStatus,
  sourceCoordinate,
  type CatalogEntry,
} from '../lib/catalog-types.js';
import { entrySearchText } from '../lib/catalog.js';
import { categoryLabel, typeLabel } from '../lib/categories.js';
import { copy, type Locale } from '../lib/i18n.js';
import CapabilityBus from './CapabilityBus.astro';

interface Props {
  entry: CatalogEntry;
  locale: Locale;
  compact?: boolean;
}

const { entry, locale, compact = false } = Astro.props;
const t = copy[locale];
const client = Boolean(entry.runtime.client);
const uiCount = entry.capabilities.uiContributions?.length;
const toolCount = entry.capabilities.tools?.length;
const factsInspected = uiCount !== undefined && toolCount !== undefined;
const modeLabel = entry.distribution.installable
  ? t.installable
  : entry.type === 'bundle'
    ? t.profileLayer
    : t.included;
const provenance = provenanceStatus(entry);
const provenanceLabel =
  provenance === 'community-reviewed'
    ? t.communityReviewed
    : provenance === 'community-submitted'
      ? t.communitySubmitted
      : provenance === 'community-automated'
        ? t.communityAutomated
        : t.builtInSource;
const provenanceStatement =
  entry.provenance?.status === 'community-reviewed' ||
  entry.provenance?.status === 'community-submitted' ||
  entry.provenance?.status === 'community-automated'
    ? localized(entry.provenance.statement, locale)
    : t.builtInSourceHelp;
---

<article
  class:list={['plugin-row', { compact }]}
  data-plugin-row
  data-catalog-item
  data-origin="registry"
  data-search={entrySearchText(entry)}
  data-type={entry.type}
  data-category={entry.category}
  data-availability={entry.distribution.installable ? 'installable' : 'included'}
  data-provenance={provenance}
  data-name={displayName(entry).toLocaleLowerCase()}
  data-stars="0"
  data-updated="registry"
>
  <div class="plugin-main">
    <div class="plugin-card-head">
      <div class="plugin-identity">
        <h3><a href={`/${locale}/plugins/${entry.slug}/`}>{displayName(entry)}</a></h3>
        <small>{sourceCoordinate(entry)}</small>
      </div>
      <span class:list={['tag', entry.distribution.installable && 'primary']}>{modeLabel}</span>
    </div>
    <div class="plugin-state-line">
      <span
        class:list={['tag', provenance !== 'built-in' && 'reviewed']}
        title={provenanceStatement}>{provenanceLabel}</span
      >
    </div>
    <p>{localized(entry.description, locale)}</p>
    <div class="tag-row">
      <span class="tag primary">{categoryLabel(entry.category, locale)}</span>
      <span class="tag">{typeLabel(entry.type, locale)}</span>
      {entry.runtime.configurable && <span class="tag">{t.configurable}</span>}
      {client && <span class="tag">{t.webUi}</span>}
      {
        (entry.availability.profiles ?? [])
          .slice(0, 2)
          .map((profile) => <span class="tag">{profile}</span>)
      }
    </div>
    {!compact && <CapabilityBus entry={entry} compact />}
  </div>
  <dl class="plugin-facts">
    <div>
      <dt>{t.version}</dt>
      <dd>{entry.version}</dd>
    </div>
    <div>
      <dt>{client ? 'UI' : factsInspected && toolCount > 0 ? 'Tools' : t.type}</dt>
      <dd>
        {
          client
            ? Math.max(uiCount ?? 0, 1)
            : factsInspected && toolCount > 0
              ? toolCount
              : typeLabel(entry.type, locale)
        }
      </dd>
    </div>
    <div>
      <dt>{entry.distribution.installable ? t.cliInstalls : t.availability}</dt>
      <dd>
        {
          entry.distribution.installable ? (
            <span data-install-count={installMetricSlug(entry)}>—</span>
          ) : entry.availability.defaultWeb === true ||
            entry.availability.defaultWeb === 'enabled' ? (
            'Web'
          ) : (
            t.included
          )
        }
      </dd>
    </div>
  </dl>
</article>

<style>
  .plugin-row {
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    contain-intrinsic-size: auto 330px;
    content-visibility: auto;
    display: grid;
    gap: 1.2rem;
    grid-template-rows: minmax(0, 1fr) auto;
    min-height: 330px;
    min-width: 0;
    padding: 1.25rem;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .plugin-row[hidden] {
    display: none;
  }

  .plugin-row:hover {
    border-color: var(--color-rule-strong);
    box-shadow: 0 12px 30px rgb(15 35 58 / 7%);
    transform: translateY(-2px);
  }

  .plugin-card-head {
    align-items: center;
    display: flex;
    gap: 0.7rem;
    justify-content: space-between;
  }

  .plugin-main {
    min-width: 0;
  }

  .plugin-identity {
    min-width: 0;
  }

  .plugin-identity small {
    color: var(--color-text-faint);
    display: block;
    font-size: 0.72rem;
    margin-top: 0.18rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .plugin-state-line {
    margin-top: 0.8rem;
  }

  .plugin-state-line :global(.tag.reviewed) {
    border-color: #5e8c76;
    color: #35654e;
  }

  h3 {
    font-size: 1rem;
    font-weight: 620;
    letter-spacing: -0.025em;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  h3 a {
    color: var(--color-text);
  }

  .plugin-main > p {
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    color: var(--color-text-muted);
    display: -webkit-box;
    font-size: 0.9rem;
    line-height: 1.58;
    margin: 0.9rem 0 0.85rem;
    max-width: 47rem;
    min-height: 4.25rem;
    overflow: hidden;
  }

  .plugin-main :global(.capability-bus) {
    margin-top: 1rem;
  }

  .plugin-facts {
    align-items: center;
    background: var(--color-surface-subtle);
    border: 1px solid color-mix(in srgb, var(--color-rule) 68%, transparent);
    border-radius: 8px;
    display: grid;
    grid-template-columns: 1.05fr 0.8fr 1.15fr;
    margin: 0;
    padding: 0.7rem 0;
  }

  .plugin-facts > div {
    border-left: 1px solid var(--color-rule);
    min-width: 0;
    padding: 0 0.75rem;
    text-align: center;
  }

  .plugin-facts dt {
    color: var(--color-text-faint);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    margin-top: 0.45rem;
    text-transform: uppercase;
  }

  .plugin-facts dd {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.86rem;
    margin: 0 0 0.3rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .plugin-row.compact {
    gap: 1rem;
    min-height: 300px;
    padding: 1.2rem;
  }

  .plugin-row.compact .plugin-main > p {
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    display: -webkit-box;
    margin-bottom: 0.7rem;
    overflow: hidden;
  }

  @media (max-width: 520px) {
    .plugin-facts {
      grid-template-columns: repeat(3, 1fr);
    }

    .plugin-facts > div {
      padding: 0 0.45rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plugin-row {
      transition: none;
    }

    .plugin-row:hover {
      transform: none;
    }
  }
</style>
