---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class="brand" aria-label="dsh.pub">
  <img
    class="brand-mark"
    src="/brand/dshbot.png"
    width="256"
    height="256"
    alt=""
    aria-hidden="true"
    decoding="async"
  />
  {
    !compact && (
      <span class="brand-word">
        dsh<span>.pub</span>
      </span>
    )
  }
</span>

<style>
  .brand {
    align-items: center;
    color: var(--brand-on-dark);
    display: inline-flex;
    gap: 0.65rem;
    min-height: 44px;
  }

  .brand-mark {
    display: block;
    height: 40px;
    object-fit: contain;
    width: 40px;
  }

  .brand-word {
    color: var(--color-text-on-dark);
    font-size: 1.45rem;
    font-weight: 560;
    letter-spacing: -0.04em;
  }

  .brand-word span {
    color: var(--color-accent-bright);
  }
</style>
