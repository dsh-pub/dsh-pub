---
import { capabilityLabels, confirmedCapabilities } from '../lib/capability-facts.js';
import type { CatalogEntry } from '../lib/catalog-types.js';
import type { Locale } from '../lib/i18n.js';
import Icon from './Icon.astro';

interface Props {
  entry: CatalogEntry;
  locale: Locale;
  compact?: boolean;
}

const { entry, locale, compact = false } = Astro.props;
const confirmed = confirmedCapabilities(entry);
---

{
  confirmed.length > 0 && (
    <div class:list={['capability-check', { compact }]}>
      <ul>
        {confirmed.map((id) => (
          <li>
            <Icon name="check" size={compact ? 12 : 14} />
            {capabilityLabels[id][locale]}
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .capability-check ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .capability-check li {
    align-items: center;
    color: var(--color-text);
    display: flex;
    font-size: 0.82rem;
    gap: 0.34rem;
    line-height: 1.3;
  }

  .capability-check li :global(.icon) {
    color: var(--color-accent);
    flex: none;
    stroke-width: 2.4;
  }

  .capability-check.compact ul {
    gap: 0.3rem 0.8rem;
  }

  .capability-check.compact li {
    color: var(--color-text-muted);
    font-size: 0.72rem;
    gap: 0.26rem;
  }
</style>
